<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="780.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="540.0" minHeight="-Infinity"
               text="Label" wrapText="true" />
        <ImageView fx:id="displayPicture" fitHeight="52.0" fitWidth="52.0"
                   pickOnBounds="true" preserveRatio="false" />
    </children>
    <padding>
        <Insets bottom="8.0" left="18.0" right="18.0" top="8.0" />
    </padding>
</fx:root>
