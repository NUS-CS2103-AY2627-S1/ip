<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <Label fx:id="text" minHeight="0.0" style="-fx-background-color: #b3d9ff; -fx-background-radius: 4;" wrapText="true">
      <HBox.margin>
         <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
      </HBox.margin>
      <padding>
         <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
      </padding>
      <font>
         <Font name="FreeMono" size="13.0"/>
      </font>
   </Label>
</fx:root>
