<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clue.ui.Gui">
   <TextField fx:id="entryField" layoutX="91.0" layoutY="366.0" minWidth="50.0" onAction="#onInput" prefHeight="50.0"
              style="-fx-background-color: #aaffaa; -fx-border-color: #3399ff;" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="50.0">
      <font>
         <Font name="FreeMono" size="13.0"/>
      </font>
   </TextField>
   <Button defaultButton="true" layoutX="547.0" layoutY="358.0" maxHeight="50.0" maxWidth="50.0" minHeight="50.0"
