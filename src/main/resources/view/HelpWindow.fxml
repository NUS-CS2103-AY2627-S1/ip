<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="520.0"
         prefWidth="800.0"
         styleClass="help-window"
         type="javafx.scene.layout.BorderPane"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox spacing="5.0" styleClass="help-header">
            <Label styleClass="help-heading" text="Command List" />
            <Label styleClass="help-subheading" text="Select a command to view its usage." />
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.32" styleClass="help-content">
            <TreeView fx:id="commandTree" minWidth="190.0" styleClass="help-command-tree" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="help-detail-scroll">
                <content>
                    <VBox spacing="18.0" styleClass="help-detail">
                        <Label fx:id="topicTitleLabel" styleClass="help-topic-title" text="Command" />
                        <Label fx:id="descriptionLabel" maxWidth="Infinity" text="Description" wrapText="true" />
                        <Label fx:id="aliasesLabel" maxWidth="Infinity" wrapText="true" />
                        <Label fx:id="usagesLabel" maxWidth="Infinity" styleClass="help-usage" wrapText="true" />
                    </VBox>
                </content>
            </ScrollPane>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="help-footer">
            <Button cancelButton="true" onAction="#closeWindow" text="Close" />
        </HBox>
    </bottom>
</fx:root>
