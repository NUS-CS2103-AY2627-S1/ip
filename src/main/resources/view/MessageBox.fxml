<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="CENTER_RIGHT" maxWidth="-Infinity" prefWidth="0.0" styleClass="message-box" stylesheets="@../style/MessageBox.css" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <Label fx:id="textLabel" maxWidth="-Infinity" minHeight="-Infinity" styleClass="message-text" wrapText="true">

            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
         <HBox.margin>
            <Insets left="7.0" right="7.0" />
         </HBox.margin>

        </Label>

        <ImageView fx:id="displayPicture" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" smooth="true" />

    </children>

    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>

</fx:root>
