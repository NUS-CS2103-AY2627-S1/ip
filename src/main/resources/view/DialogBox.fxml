<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="HBox" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER_LEFT" spacing="10.0">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="40.0" fitWidth="40.0" preserveRatio="true" />
        <Label fx:id="dialog" maxWidth="300.0" wrapText="true" styleClass="dialog-text" />
    </children>
</fx:root>
