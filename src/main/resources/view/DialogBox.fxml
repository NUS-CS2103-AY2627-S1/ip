<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<fx:root alignment="TOP_LEFT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         minHeight="-Infinity"
         prefWidth="440.0"
         spacing="8.0"
         styleClass="dialog-row"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane fx:id="botMark"
                   minHeight="32.0"
                   minWidth="32.0"
                   prefHeight="32.0"
                   prefWidth="32.0">
            <children>
                <Circle radius="16.0" styleClass="bot-mark-background" />
                <Label styleClass="bot-mark-letter" text="L" />
            </children>
        </StackPane>
        <Label fx:id="dialog"
               minHeight="-Infinity"
               styleClass="message-label"
               text="Message"
               wrapText="true" />
    </children>
</fx:root>
