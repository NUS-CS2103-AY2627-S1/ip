<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         alignment="TOP_RIGHT" spacing="10.0" styleClass="dialog-box">
    <children>
        <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity"
               HBox.hgrow="ALWAYS" styleClass="dialog-label" />
        <Label fx:id="avatar" text="" alignment="CENTER" styleClass="avatar"
               minWidth="50.0" minHeight="50.0" prefWidth="50.0" prefHeight="50.0"
               maxWidth="50.0" maxHeight="50.0" style="-fx-font-size: 22px;" />
    </children>
    <padding>
        <javafx.geometry.Insets bottom="5" left="5" right="5" top="5" />
    </padding>
</fx:root>
