<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308" prefWidth="400.0" spacing="8.0"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../css/dialog-box.css">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="56.0" fitWidth="56.0"
                   pickOnBounds="true" preserveRatio="false" />
        <Label fx:id="dialog" minHeight="-Infinity" styleClass="message-label" text="Label" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
    </padding>
</fx:root>
