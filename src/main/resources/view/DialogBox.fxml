<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
         prefWidth="400.0" spacing="8.0" stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true">
            <HBox.margin>
                <Insets left="6.0" right="6.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
            </padding>
        </Label>
        <StackPane minHeight="64.0" minWidth="64.0" prefHeight="64.0" prefWidth="64.0">
            <children>
                <ImageView fx:id="displayPicture" fitHeight="58.0" fitWidth="58.0" pickOnBounds="true"
                           preserveRatio="true">
                    <clip>
                        <Circle centerX="29.0" centerY="29.0" radius="29.0" />
                    </clip>
                </ImageView>
                <Circle fx:id="avatarBorder" mouseTransparent="true" radius="30.0" />
            </children>
        </StackPane>
    </children>
</fx:root>
