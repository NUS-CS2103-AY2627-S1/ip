<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" spacing="10.0"
         stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" wrapText="true" />
        <ImageView fx:id="displayPicture" fitHeight="64.0" fitWidth="64.0"
                   pickOnBounds="true" preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
    </padding>
</fx:root>
