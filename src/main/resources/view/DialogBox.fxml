<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxWidth="1.7976931348623157E308"
         prefWidth="400.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@../css/dialog-box.css" />
  </stylesheets>
  <children>
    <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity">
      <HBox.margin>
        <Insets left="9.0" right="9.0" />
      </HBox.margin>
      <padding>
        <Insets bottom="9.0" left="12.0" right="12.0" top="9.0" />
      </padding>
    </Label>
    <ImageView fx:id="displayPicture" fitHeight="44.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
  </padding>
</fx:root>
