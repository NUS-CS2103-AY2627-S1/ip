<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         styleClass="dialog-row"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialogText"
               maxWidth="1.7976931348623157E308"
               minHeight="-Infinity"
               styleClass="message-bubble"
               text="Message"
               wrapText="true">
            <HBox.margin>
                <Insets left="8.0" right="8.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="9.0" left="12.0" right="12.0" top="9.0" />
            </padding>
        </Label>
        <ImageView fx:id="displayPicture"
                   fitHeight="36.0"
                   fitWidth="36.0"
                   pickOnBounds="true"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
    </padding>
</fx:root>
