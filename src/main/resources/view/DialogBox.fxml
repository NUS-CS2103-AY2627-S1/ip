<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.StackPane?>
<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="400.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         stylesheets="@/css/dialog-box.css">
    <children>
        <Label fx:id="textDisplay"
               text="Label"
               wrapText="true"
               minHeight="-Infinity"/>
        <StackPane>
            <Circle styleClass="avatar-border"
                    centerX="50.0"
                    centerY="50.0"
                    radius="50.0"/>
            <ImageView fx:id="profilePictureDisplay"
                       fitHeight="100.0"
                       fitWidth="100.0"
                       pickOnBounds="true"
                       preserveRatio="false">
                <clip>
                    <Circle centerX="50.0" centerY="50.0" radius="45.0"/>
                </clip>
            </ImageView>

        </StackPane>
    </children>
    <padding>
        <Insets bottom="15.0" top="15.0"
                left="5.0" right="5.0"/>
    </padding>

</fx:root>
