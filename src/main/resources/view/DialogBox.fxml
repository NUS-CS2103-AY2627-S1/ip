<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308" prefWidth="400.0"
         stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true">
            <HBox.margin>
                <Insets left="9.0" right="9.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
            </padding>
        </Label>
        <StackPane minWidth="70.0" prefWidth="70.0" maxWidth="70.0"
                   minHeight="70.0" prefHeight="70.0" maxHeight="70.0">
            <ImageView fx:id="displayPicture" fitHeight="70.0" fitWidth="70.0"
                       pickOnBounds="true" preserveRatio="false">
                <clip>
                    <Circle centerX="35.0" centerY="35.0" radius="35.0" />
                </clip>
            </ImageView>
            <ImageView fitWidth="80.0" fitHeight="80.0"
                       mouseTransparent="true" preserveRatio="true">
                <image>
                    <Image url="@../images/tree-frame.png" />
                </image>
            </ImageView>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="15.0" left="5.0" right="5.0" top="15.0" />
    </padding>
</fx:root>
