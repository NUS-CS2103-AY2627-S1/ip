<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<fx:root alignment="TOP_RIGHT" fillHeight="true" spacing="8.0"
         stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="1.7976931348623157E308"
               minHeight="-Infinity" styleClass="dialog-label" wrapText="true"
               HBox.hgrow="ALWAYS" />
        <StackPane maxHeight="56.0" maxWidth="56.0" minHeight="56.0"
                   minWidth="56.0" prefHeight="56.0" prefWidth="56.0">
            <children>
                <Circle fill="#DDE8D8" radius="27.0" />
                <Label fx:id="avatarPlaceholder" styleClass="avatar-placeholder" />
                <ImageView fx:id="displayPicture" fitHeight="54.0" fitWidth="54.0"
                           preserveRatio="true" />
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="4.0" left="10.0" right="10.0" top="4.0" />
    </padding>
</fx:root>
