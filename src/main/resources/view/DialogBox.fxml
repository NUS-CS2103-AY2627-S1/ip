<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="8.0"
         maxWidth="400.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="6.0" right="6.0" bottom="6.0" left="6.0" />
    </padding>
    <children>
        <Label fx:id="dialog" wrapText="true" maxWidth="300.0"
               style="-fx-font-family: 'monospace'; -fx-background-color: #eef1f6; -fx-padding: 8; -fx-background-radius: 8;" />
        <ImageView fx:id="displayPicture" fitHeight="48.0" fitWidth="48.0" preserveRatio="true" />
    </children>
</fx:root>
