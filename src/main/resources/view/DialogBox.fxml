<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="10.0"
         maxWidth="1.7976931348623157E308" minHeight="-Infinity"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="text" wrapText="true" minHeight="-Infinity" maxWidth="250.0"
               styleClass="chat-message" />
        <ImageView fx:id="displayPicture" fitHeight="48.0" fitWidth="48.0" preserveRatio="true" />
    </children>
</fx:root>
