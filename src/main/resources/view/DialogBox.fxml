<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" minHeight="-Infinity" minWidth="0.0" maxWidth="1.7976931348623157E308" spacing="8.0" stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" minWidth="0.0" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" text="Label" wrapText="true">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding></Label>
        <ImageView fx:id="displayPicture" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="2.0" left="0.0" right="0.0" top="2.0" />
    </padding>
</fx:root>
