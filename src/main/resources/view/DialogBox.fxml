<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root maxWidth="1.7976931348623157E308" styleClass="message-row"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox spacing="6.0" styleClass="message-content" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="senderLabel" styleClass="sender-label" />
                <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308"
                       styleClass="message-label" wrapText="true" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
    </padding>
</fx:root>
