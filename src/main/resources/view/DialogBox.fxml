<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_LEFT" spacing="8.0" type="javafx.scene.layout.HBox"
         stylesheets="@../css/dialog-box.css"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="displayPicture" minHeight="50.0" minWidth="50.0"
               prefHeight="50.0" prefWidth="50.0" styleClass="avatar-label" />
        <Label fx:id="dialog" maxWidth="310.0" styleClass="message-label" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
    </padding>
</fx:root>
