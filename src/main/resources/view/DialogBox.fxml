<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true">
         <HBox.margin>
            <Insets left="8.0" right="8.0" />
         </HBox.margin>
         <padding>
            <Insets bottom="9.0" left="11.0" right="11.0" top="9.0" />
         </padding></Label>
    </children>
    <padding>
        <Insets bottom="5.0" left="14.0" right="14.0" top="5.0" />
    </padding>
</fx:root>
