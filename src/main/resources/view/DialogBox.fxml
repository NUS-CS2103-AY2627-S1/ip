<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         spacing="10.0"
         styleClass="dialog-row"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="displayPicture"
                   fitHeight="40.0"
                   fitWidth="40.0"
                   managed="false"
                   mouseTransparent="true"
                   preserveRatio="true"
                   visible="false" />
        <VBox fx:id="messageContent" alignment="TOP_RIGHT" spacing="5.0">
            <children>
                <Label fx:id="senderName" styleClass="sender-name" text="You" />
                <Label fx:id="dialog"
                       maxWidth="460.0"
                       minHeight="-Infinity"
                       styleClass="dialog-bubble"
                       text="Label"
                       wrapText="true">
                    <padding>
                        <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                    </padding>
                </Label>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="3.0" left="22.0" right="22.0" top="3.0" />
    </padding>
</fx:root>
