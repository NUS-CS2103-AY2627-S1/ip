<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<fx:root alignment="TOP_RIGHT" prefWidth="400.0" stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" wrapText="true">
            <HBox.margin><Insets left="7.0" right="7.0" /></HBox.margin>
            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="40.0" fitWidth="40.0" preserveRatio="true" />
    </children>
    <padding><Insets bottom="15.0" left="5.0" right="5.0" top="15.0" /></padding>
</fx:root>
