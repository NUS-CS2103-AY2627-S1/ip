<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root type="HBox" xmlns="http://javafx.com/javafx/17.0.7"
         xmlns:fx="http://javafx.com/fxml/1" spacing="10">
    <children>
        <StackPane fx:id="avatarContainer" styleClass="avatar-container">
            <children>
                <ImageView fx:id="avatar" styleClass="megatron-avatar" />
            </children>
        </StackPane>
        <Label fx:id="messageLabel" styleClass="dialog-text" wrapText="true" />
    </children>
</fx:root>
