<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<fx:root type="HBox"
         alignment="CENTER_RIGHT"
         spacing="10.0"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <!-- Pushes the bubble to the speaker's side of the window. -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- The bubble's look lives in style.css; its maximum width is
             bound to the chat area in DialogBox.bindTextWidthTo so that
             text re-wraps when the window is resized. -->
        <Label fx:id="dialog"
               wrapText="true"
               styleClass="dialog-bubble" />

        <ImageView fx:id="displayPicture"
                   fitHeight="50.0"
                   fitWidth="50.0"
                   preserveRatio="true" />
    </children>
</fx:root>
