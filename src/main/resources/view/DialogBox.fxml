<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<fx:root alignment="TOP_RIGHT" maxWidth="Infinity" stylesheets="@dialog-box.css"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox fx:id="message" minWidth="0.0" maxWidth="Infinity" spacing="6.0">
            <children>
                <Label fx:id="heading" text="GRONK!" styleClass="message-heading" />
                <Label fx:id="errorHeading" text="ERROR / Gronk hit a snag"
                       styleClass="error-heading" visible="false" managed="false" wrapText="true" />
                <Label fx:id="dialog" minWidth="0.0" minHeight="-Infinity" maxWidth="Infinity"
                       styleClass="message-text" wrapText="true" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
    </padding>
</fx:root>
