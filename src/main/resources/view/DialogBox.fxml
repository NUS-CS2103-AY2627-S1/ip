<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<!--
  One message in the conversation. fx:root means the loader fills in the HBox
  that DialogBox itself is, rather than creating a new one, which is what lets
  DialogBox be its own layout and controller at the same time.

  maxWidth="Infinity" makes every row span the full width of the conversation
  whatever it contains, and minWidth="0" lets it be squeezed narrower than the
  text inside it. Together they are what let DialogBox cap the bubble's width
  against this row's width without the two sizes chasing each other: the row is
  sized by the window, never by the bubble inside it.
-->
<fx:root alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="Infinity" minWidth="0.0" spacing="8.0"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="3.0" left="10.0" right="10.0" top="3.0" />
    </padding>
    <children>
        <!-- Size is set by DialogBox, which must match it to the circular clip. -->
        <ImageView fx:id="displayPicture" pickOnBounds="true" preserveRatio="true" />
        <!-- wrapText keeps a long reply inside the window instead of stretching it. -->
        <Label fx:id="dialog" styleClass="dialog-label" text="Label" wrapText="true" />
    </children>
</fx:root>
