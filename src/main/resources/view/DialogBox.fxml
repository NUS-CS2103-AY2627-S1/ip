<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<!--
    fx:root (rather than a plain <HBox> tag) is required here because
    DialogBox.java calls FXMLLoader.setRoot(this) before loading: the
    loader needs to be told what type the already-constructed root object
    is, instead of being asked to instantiate a new one.

    The display picture is small and shown only for Alice; the user's own
    messages are identified by being right-aligned and accent-coloured,
    which keeps the two sides visually distinct without spending 50px of a
    narrow window on a picture beside every single line.

    The label is declared before the image so that flipping the box for
    Alice's replies (which reverses the children) leaves her avatar on the
    left, the side her messages are aligned to.
-->
<fx:root alignment="TOP_RIGHT" maxHeight="Infinity" minHeight="-Infinity" spacing="8"
         type="HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <Label fx:id="dialog" minHeight="-Infinity" styleClass="bubble" wrapText="true"/>
    <ImageView fx:id="displayPicture" fitHeight="32.0" fitWidth="32.0" preserveRatio="true"/>
</fx:root>
