<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@../css/dialog-box.css" />
  </stylesheets>
  <children>
    <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity">
      <padding>
        <Insets bottom="7.0" left="10.0" right="10.0" top="7.0" />
      </padding>
    </Label>
    <ImageView fx:id="displayPicture" fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="4.0" left="8.0" right="8.0" top="4.0" />
  </padding>
</fx:root>
