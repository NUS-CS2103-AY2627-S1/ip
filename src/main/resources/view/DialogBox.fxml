<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_LEFT"
         spacing="8.0"
         maxWidth="1.7976931348623157E308"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@../css/dialog-box.css" />
  </stylesheets>
  <children>
    <ImageView fx:id="displayPicture" fitHeight="36.0" fitWidth="36.0" smooth="true" />
    <Label fx:id="dialog" styleClass="bubble" text="Label" wrapText="true" minHeight="-Infinity" />
  </children>
  <padding>
    <Insets bottom="4.0" left="10.0" right="10.0" top="4.0" />
  </padding>
</fx:root>
