<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<!--
  Declared as an fx:root so that DialogBox can be both the root node and the
  controller. That is what lets the class be created in Java, with the text and
  picture passed in, while its layout still lives here.

  The order below is the user's: words then picture. DialogBox.flip() reverses it
  for Bibi's replies.
-->
<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="10.0"
         maxWidth="Infinity" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="dialog" wrapText="true" maxWidth="300.0" alignment="TOP_RIGHT" />
    <ImageView fx:id="displayPicture" fitHeight="56.0" fitWidth="56.0"
               pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
  </padding>
</fx:root>
