<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" 
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         spacing="10" 
         alignment="TOP_RIGHT" 
         styleClass="dialog-box">

    <Label fx:id="dialog" text="Label" wrapText="true" maxWidth="320" styleClass="dialog-label">
        <padding>
            <Insets top="8" right="12" bottom="8" left="12"/>
        </padding>
    </Label>

    <ImageView fx:id="displayPicture" fitWidth="40" fitHeight="40" preserveRatio="true" styleClass="avatar"/>

</fx:root>
