<?xml version="1.0" encoding="UTF-8"?>

<!--
  One speech bubble: what was said, and a picture of who said it.

  fx:root rather than a named layout class, so that loading this file fills in
  the DialogBox that asked for it instead of making a second HBox beside it.

  The Label needs both wrapText="true" and minHeight="-Infinity": the first wraps
  a long answer onto several lines, and the second lets the bubble grow tall
  enough to show them all rather than clipping to one line's worth of height.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         spacing="10.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog"
               styleClass="dialog-bubble"
               minHeight="-Infinity"
               text="Label"
               wrapText="true" />
        <ImageView fx:id="displayPicture"
                   fitHeight="44.0"
                   fitWidth="44.0"
                   pickOnBounds="true"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
    </padding>
</fx:root>
