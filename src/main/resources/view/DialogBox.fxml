<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root alignment="BOTTOM_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true">
         <HBox.margin>
            <Insets left="7.0" right="7.0" />
         </HBox.margin>
         <padding>
            <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
         </padding></Label>
        <StackPane fx:id="avatarContainer" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0"
                   prefHeight="38.0" prefWidth="38.0" styleClass="avatar-ring">
            <HBox.margin>
                <Insets left="2.0" right="2.0" />
            </HBox.margin>
            <children>
                <ImageView fx:id="displayPicture" fitHeight="34.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
    </padding>
    <stylesheets>
        <URL value="@../css/dialog-box.css" />
    </stylesheets>
</fx:root>
