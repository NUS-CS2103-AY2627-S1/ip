<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="420.0"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog"
               minHeight="-Infinity"
               text="Label"
               wrapText="true">
            <HBox.margin>
                <Insets left="6.0" right="6.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="9.0" left="12.0" right="12.0" top="9.0" />
            </padding>
        </Label>
        <StackPane maxHeight="36.0"
                   maxWidth="36.0"
                   minHeight="36.0"
                   minWidth="36.0"
                   prefHeight="36.0"
                   prefWidth="36.0">
            <HBox.margin>
                <Insets left="4.0" right="4.0" />
            </HBox.margin>
            <children>
                <ImageView fx:id="displayPicture"
                           fitHeight="36.0"
                           fitWidth="36.0"
                           pickOnBounds="true"
                           preserveRatio="true" />
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
    </padding>
</fx:root>
