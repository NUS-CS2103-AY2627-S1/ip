<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root alignment="TOP_RIGHT" spacing="10.0" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
    </padding>
    <children>
        <Label fx:id="dialog" maxWidth="300.0" text="Label" wrapText="true">
            <styleClass>
                <String fx:value="dialog-label" />
                <String fx:value="user-label" />
            </styleClass>
            <HBox.margin>
                <Insets left="7.0" right="7.0" />
            </HBox.margin>
        </Label>
        <StackPane maxHeight="84.0" maxWidth="84.0" minHeight="84.0" minWidth="84.0" prefHeight="84.0" prefWidth="84.0">
            <styleClass>
                <String fx:value="avatar-frame" />
            </styleClass>
            <HBox.margin>
                <Insets left="4.0" right="4.0" />
            </HBox.margin>
            <children>
                <ImageView fx:id="displayPicture" fitHeight="76.0" fitWidth="76.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </StackPane>
    </children>
</fx:root>
