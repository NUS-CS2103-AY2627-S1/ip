<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="text" maxWidth="620.0" wrapText="true" />
        <ImageView fx:id="avatar" fitHeight="32.0" fitWidth="32.0" preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="3.0" left="4.0" right="4.0" top="3.0" />
    </padding>
</fx:root>
