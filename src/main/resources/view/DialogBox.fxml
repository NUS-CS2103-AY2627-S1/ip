<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_LEFT" fillHeight="false" maxWidth="1.7976931348623157E308"
         spacing="8.0" styleClass="dialog-box" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="avatar" alignment="CENTER" minHeight="28.0" minWidth="28.0"
               prefHeight="28.0" prefWidth="28.0" styleClass="avatar" />
        <Label fx:id="dialog" minHeight="-Infinity" minWidth="80.0"
               styleClass="dialog-text" text="Message" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
    </padding>
</fx:root>
