<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox fx:id="messageContent" spacing="3.0" styleClass="message-content">
            <children>
                <Label fx:id="senderLabel" styleClass="message-sender" />
                <Label fx:id="dialog" minHeight="-Infinity" styleClass="message-text" wrapText="true" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
    </padding>
    <stylesheets>
        <URL value="@../css/dialog-box.css" />
    </stylesheets>
</fx:root>
