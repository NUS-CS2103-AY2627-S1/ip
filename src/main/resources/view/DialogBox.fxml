<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="Infinity" minWidth="0.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox fx:id="message" minWidth="0.0" spacing="5.0" styleClass="message-bubble">
            <children>
                <Label fx:id="speaker" styleClass="speaker" />
                <Label fx:id="dialog" maxWidth="Infinity" minWidth="0.0" minHeight="-Infinity"
                       styleClass="message-text" wrapText="true" />
            </children>
        </VBox>
    </children>
</fx:root>
