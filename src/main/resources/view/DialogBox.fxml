<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" spacing="3.0"
         maxWidth="1.7976931348623157E308" prefWidth="400.0"
         styleClass="dialog-box" stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity"
               styleClass="dialog-label" text="Label" wrapText="true">
            <padding>
                <Insets bottom="10.0" left="13.0" right="13.0" top="10.0" />
            </padding>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="32.0" fitWidth="32.0"
                   pickOnBounds="true" preserveRatio="true" />
    </children>
</fx:root>
