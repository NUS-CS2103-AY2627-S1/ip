<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minWidth="0.0" wrapText="true" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets left="7.0" right="7.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
            </padding>
        </Label>
        <StackPane styleClass="avatar" minWidth="64.0" prefWidth="64.0" maxWidth="64.0"
                   minHeight="64.0" prefHeight="64.0" maxHeight="64.0">
            <children>
                <ImageView fx:id="displayPicture" fitHeight="64.0" fitWidth="64.0"
                           pickOnBounds="true" preserveRatio="true" smooth="true" />
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="6.0" left="5.0" right="5.0" top="6.0" />
    </padding>
</fx:root>
