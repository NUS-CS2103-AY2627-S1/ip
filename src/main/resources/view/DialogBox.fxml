<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<fx:root alignment="TOP_LEFT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         spacing="10.0"
         styleClass="dialog-row"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane fx:id="displayPictureFrame"
                   maxHeight="40.0"
                   maxWidth="40.0"
                   minHeight="40.0"
                   minWidth="40.0"
                   prefHeight="40.0"
                   prefWidth="40.0"
                   styleClass="avatar-frame">
            <children>
                <ImageView fx:id="displayPicture"
                           fitHeight="40.0"
                           fitWidth="40.0"
                           pickOnBounds="true"
                           preserveRatio="false"
                           smooth="true" />
            </children>
        </StackPane>
        <Label fx:id="dialog"
               minHeight="-Infinity"
               styleClass="dialog-label"
               text="Label"
               wrapText="true" />
    </children>
    <padding>
        <Insets bottom="4.0" left="12.0" right="12.0" top="4.0" />
    </padding>
</fx:root>
