<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" prefWidth="440.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox fx:id="messageBox" spacing="3.0">
            <Label fx:id="speaker" styleClass="speaker" />
            <Label fx:id="dialog" minHeight="-Infinity" styleClass="message" wrapText="true" />
        </VBox>
    </children>
    <padding>
        <Insets bottom="18.0" left="28.0" right="28.0" top="8.0" />
    </padding>
</fx:root>
