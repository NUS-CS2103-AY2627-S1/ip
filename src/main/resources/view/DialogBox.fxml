<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_LEFT" maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308" prefWidth="400.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="28.0" fitWidth="28.0"
                   preserveRatio="true" smooth="true" />
        <Label fx:id="speaker" styleClass="speaker-label" />
        <Label fx:id="text" styleClass="message-label" minHeight="-Infinity" wrapText="true" />
    </children>
</fx:root>
