<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT"
         xmlns:fx="http://javafx.com/fxml/1" maxWidth="1.7976931348623157E308">
    <children>
        <Label fx:id="dialog" wrapText="true" minHeight="-Infinity" />
        <ImageView fx:id="displayPicture" fitHeight="48.0" fitWidth="48.0"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="6.0" left="5.0" right="5.0" top="6.0" />
    </padding>
</fx:root>
