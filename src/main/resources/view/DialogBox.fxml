<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" type="HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         stylesheets="@../css/dialog-box.css">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" text="Label" wrapText="true"/>
        <ImageView fx:id="displayPicture" fitHeight="100.0" fitWidth="100.0"/>
    </children>
</fx:root>
