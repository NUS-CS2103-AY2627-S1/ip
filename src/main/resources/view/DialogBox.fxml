<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>

<!-- AI-assisted: most of this file was written with Claude Code (Claude Opus),
     used by Ryan Chua, who reviewed and adapted the output. -->

<!--
    One message in the conversation, laid out as Myriad's reply: a small
    picture on the left and the text beside it. A user's message reuses this
    layout with the picture removed and the row aligned right (see
    DialogBox.getUserDialog).

    This is an fx:root layout rather than a controller-backed one: DialogBox
    sets itself as both root and controller, so each instance loads this file
    into itself and there is no fx:controller attribute naming a class here.
-->
<fx:root alignment="TOP_LEFT"
         maxWidth="1.7976931348623157E308"
         minWidth="0.0"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="32.0" fitWidth="32.0"
                   pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="dialog" minHeight="-Infinity" minWidth="0.0" text="Label" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="3.0" left="8.0" right="8.0" top="3.0" />
    </padding>
    <stylesheets>
        <URL value="@../css/dialog-box.css" />
    </stylesheets>
</fx:root>
