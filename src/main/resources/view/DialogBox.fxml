<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity"
               styleClass="message-bubble" text="Message" wrapText="true" />
        <ImageView fx:id="displayPicture" fitHeight="42.0" fitWidth="42.0"
                   pickOnBounds="true" preserveRatio="true" smooth="true"
                   styleClass="avatar" />
    </children>
    <padding>
        <Insets bottom="4.0" left="14.0" right="14.0" top="4.0" />
    </padding>
</fx:root>
