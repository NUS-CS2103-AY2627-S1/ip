<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="8.0"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity"
               maxWidth="300.0" styleClass="dialog-label" />
        <ImageView fx:id="displayPicture" fitHeight="45.0" fitWidth="45.0" preserveRatio="true">
            <clip>
                <Circle radius="22.5" centerX="22.5" centerY="22.5" />
            </clip>
        </ImageView>
    </children>
    <padding>
        <Insets top="10.0" right="12.0" bottom="10.0" left="12.0" />
    </padding>
</fx:root>
