<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="500.0"
         spacing="6.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1"
         stylesheets="@../css/dialog-box.css">
  <children>
    <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity" styleClass="message-label">
        <HBox.margin>
            <Insets left="2.0" right="2.0" />
        </HBox.margin>
        <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
        </padding>
    </Label>
    <ImageView fx:id="displayPicture" fitHeight="44.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
  </padding>
</fx:root>
