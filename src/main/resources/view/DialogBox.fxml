<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" styleClass="dialog-text" wrapText="true"
               maxWidth="1.7976931348623157E308" />
        <ImageView fx:id="avatar" fitHeight="36.0" fitWidth="36.0"
                   preserveRatio="true" smooth="true" styleClass="avatar" />
    </children>
    <padding>
        <Insets top="5.0" right="12.0" bottom="5.0" left="12.0" />
    </padding>
</fx:root>
