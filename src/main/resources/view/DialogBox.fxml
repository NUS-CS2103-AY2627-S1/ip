<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<fx:root alignment="TOP_CENTER" prefWidth="388.0" stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Region fx:id="topDivider" managed="false" maxHeight="1.0" maxWidth="Infinity" minHeight="1.0" prefHeight="1.0"
                styleClass="reply-divider" visible="false">
            <VBox.margin>
                <Insets left="32.0" right="32.0" />
            </VBox.margin>
        </Region>
        <HBox fx:id="messageRow" alignment="TOP_RIGHT" prefWidth="388.0">
            <children>
                <Label fx:id="dialog" wrapText="true">
                    <HBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </HBox.margin>
                </Label>
                <ImageView fx:id="displayPicture" fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                    <clip>
                        <Circle centerX="24.0" centerY="24.0" radius="24.0" />
                    </clip>
                </ImageView>
            </children>
            <padding>
                <Insets bottom="8.0" left="5.0" right="5.0" top="8.0" />
            </padding>
        </HBox>
        <Region fx:id="bottomDivider" managed="false" maxHeight="1.0" maxWidth="Infinity" minHeight="1.0" prefHeight="1.0"
                styleClass="reply-divider" visible="false">
            <VBox.margin>
                <Insets left="32.0" right="32.0" />
            </VBox.margin>
        </Region>
    </children>
</fx:root>
