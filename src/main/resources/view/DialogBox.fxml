<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<fx:root type="HBox" xmlns:fx="http://javafx.com/fxml"
         alignment="TOP_RIGHT" spacing="10.0">
    <children>
        <TextFlow fx:id="dialog" maxWidth="320.0" styleClass="bubble">
            <children>
                <Text fx:id="messageText" styleClass="message-text" />
                <Text fx:id="timestampText" styleClass="timestamp-text" />
            </children>
        </TextFlow>
        <ImageView fx:id="displayPicture" fitHeight="40.0" fitWidth="40.0"
                   preserveRatio="true" styleClass="avatar" />
    </children>
    <padding>
        <Insets top="6.0" right="4.0" bottom="6.0" left="4.0" />
    </padding>
</fx:root>
