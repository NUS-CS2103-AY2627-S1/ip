<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import java.net.URL?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/dialog-box.css" />
    </stylesheets>
    <children>
        <Label fx:id="dialog" text="Message" wrapText="true">
            <HBox.margin>
                <Insets left="7.0" right="7.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
            </padding>
        </Label>
        <ImageView fx:id="displayPicture"
                   fitHeight="52.0"
                   fitWidth="52.0"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="9.0" left="5.0" right="5.0" top="9.0" />
    </padding>
</fx:root>
