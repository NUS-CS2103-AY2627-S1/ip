<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" styleClass="dialog-box"
         minWidth="0.0" minHeight="-Infinity" stylesheets="@../css/dialog-box.css"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox fx:id="message" styleClass="message-card" minWidth="0.0" spacing="6.0">
            <children>
                <Label fx:id="messageType" text="ATTENTION NEEDED" styleClass="message-type"
                       visible="false" managed="false" />
                <Label fx:id="dialog" styleClass="dialog-text" wrapText="true"
                       minWidth="0.0" minHeight="-Infinity" maxWidth="Infinity" />
            </children>
        </VBox>
    </children>
</fx:root>
