<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../css/dialog-box.css" />
    </stylesheets>
    <children>
        <Label fx:id="dialog" text="Label" maxWidth="300.0" wrapText="true"
               minHeight="-Infinity" />
        <ImageView fx:id="displayPicture" fitHeight="36.0" fitWidth="36.0"
                   pickOnBounds="true" preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="8.0" left="4.0" right="4.0" top="8.0" />
    </padding>
</fx:root>
