<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" spacing="8.0" prefWidth="400.0" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" styleClass="message-text" wrapText="true" />
        <Label fx:id="speaker" minWidth="60.0" styleClass="speaker-label" />
    </children>
    <padding>
        <Insets bottom="12.0" left="8.0" right="8.0" top="12.0" />
    </padding>
</fx:root>
