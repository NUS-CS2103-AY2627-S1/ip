<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<!--
  One message. Laid out for Alfred: avatar on the left, then the text. The
  user's boxes drop the avatar and move to the right in DialogBox.java.
-->
<fx:root alignment="TOP_LEFT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <ImageView fx:id="displayPicture" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" />
    <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity">
      <padding>
        <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
      </padding>
    </Label>
  </children>
  <padding>
    <Insets bottom="4.0" left="10.0" right="10.0" top="4.0" />
  </padding>
  <stylesheets>
    <URL value="@../css/dialog-box.css" />
  </stylesheets>
</fx:root>
