<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         fillHeight="true"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         styleClass="dialog-row"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog"
               minHeight="-Infinity"
               minWidth="0.0"
               styleClass="dialog-label"
               text="Label"
               wrapText="true" />
        <ImageView fx:id="displayPicture"
                   fitHeight="36.0"
                   fitWidth="36.0"
                   pickOnBounds="true"
                   preserveRatio="false"
                   styleClass="avatar" />
    </children>
    <padding>
        <Insets bottom="5.0" left="12.0" right="12.0" top="5.0" />
    </padding>
</fx:root>
