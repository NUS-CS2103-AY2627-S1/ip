<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" prefWidth="490.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="1.7976931348623157E308" minHeight="-Infinity" wrapText="true" />
        <StackPane alignment="CENTER" minHeight="80.0" minWidth="80.0" maxHeight="80.0" maxWidth="80.0"
                   prefHeight="80.0" prefWidth="80.0" styleClass="avatar-container">
            <children>
                <ImageView fx:id="displayPicture" fitHeight="76.0" fitWidth="76.0" preserveRatio="true">
                    <clip>
                        <Circle centerX="38.0" centerY="38.0" radius="38.0" />
                    </clip>
                </ImageView>
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
    </padding>
</fx:root>
