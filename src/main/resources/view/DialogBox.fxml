<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import java.net.URL?>

<fx:root alignment="TOP_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         prefWidth="720.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" text="Label" wrapText="true" minHeight="-Infinity"/>
        <ImageView fx:id="displayPicture"
                   fitHeight="68.0"
                   fitWidth="68.0"
                   pickOnBounds="true"
                   preserveRatio="false"
                   smooth="true" />
    </children>
    <padding>
        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0" />
    </padding>
    <stylesheets>
        <URL value="@../css/dialog-box.css" />
    </stylesheets>
</fx:root>
