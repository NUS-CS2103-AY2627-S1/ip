<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" minWidth="0.0"
               styleClass="dialog-bubble" wrapText="true">
            <HBox.margin>
                <Insets left="5.0" right="5.0" />
            </HBox.margin>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="56.0" fitWidth="56.0"
                   pickOnBounds="true" preserveRatio="true" styleClass="avatar">
            <HBox.margin>
                <Insets bottom="1.0" left="3.0" right="3.0" top="1.0" />
            </HBox.margin>
        </ImageView>
    </children>
    <padding>
        <Insets bottom="3.0" top="3.0" />
    </padding>
</fx:root>
