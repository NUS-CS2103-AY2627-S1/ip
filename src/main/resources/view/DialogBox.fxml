<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="BOTTOM_RIGHT"
         maxHeight="1.7976931348623157E308"
         maxWidth="1.7976931348623157E308"
         styleClass="dialog-box"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="3.0" left="14.0" right="14.0" top="3.0"/>
    </padding>
    <Label fx:id="text"
           maxWidth="520.0"
           minHeight="-Infinity"
           styleClass="message-bubble"
           text="Message"
           wrapText="true"/>
    <ImageView fx:id="displayPicture"
               fitHeight="42.0"
               fitWidth="42.0"
               pickOnBounds="true"
               preserveRatio="true"
               styleClass="message-avatar"/>
</fx:root>
