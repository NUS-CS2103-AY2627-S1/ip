<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root alignment="BOTTOM_RIGHT" maxWidth="1.7976931348623157E308" styleClass="dialog-box" stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox fx:id="messageContent" spacing="4" styleClass="message-content">
            <children>
                <Label fx:id="speakerName" styleClass="speaker-name" text="You">
               <font>
                  <Font name="Google Sans SemiBold" size="13.0" />
               </font></Label>
                <Label fx:id="dialog" styleClass="dialog-label" text="Label">
               <font>
                  <Font name="Google Sans Flex Regular" size="11.0" />
               </font></Label>
            </children>
        </VBox>
        <ImageView fx:id="displayPicture" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" styleClass="avatar" />
    </children>
    <padding>
        <Insets bottom="5.0" left="8.0" right="8.0" top="5.0" />
    </padding>
</fx:root>
