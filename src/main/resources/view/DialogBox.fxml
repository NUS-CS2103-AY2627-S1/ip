<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308" spacing="8.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" minHeight="-Infinity" wrapText="true" />
        <Label fx:id="avatar" alignment="CENTER" minHeight="28.0" minWidth="28.0"
               prefHeight="28.0" prefWidth="28.0" />
    </children>
    <padding>
        <Insets bottom="2.0" left="0.0" right="0.0" top="2.0" />
    </padding>
</fx:root>
