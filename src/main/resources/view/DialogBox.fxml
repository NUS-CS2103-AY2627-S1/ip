<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT"
         maxWidth="1.7976931348623157E308"
         spacing="10.0"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="460.0" minHeight="-Infinity"
               styleClass="dialog" wrapText="true" />
        <Label fx:id="avatar" alignment="CENTER" minHeight="46.0"
               minWidth="46.0" styleClass="avatar" />
    </children>
    <padding>
        <Insets bottom="4.0" left="20.0" right="20.0" top="4.0" />
    </padding>
</fx:root>
