<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<!--suppress XmlUnboundNsPrefix -->
<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="400.0" stylesheets="@../css/dialog-box.css" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxHeight="1.7976931348623157E308" text="Label" wrapText="true">
            <HBox.margin>
                <Insets left="6.0" right="6.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
        </Label>

        <ImageView fx:id="displayPicture" fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="6.0" left="4.0" right="4.0" top="6.0" />
    </padding>
</fx:root>
