<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         styleClass="dialog-box" stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="360.0" minHeight="-Infinity"
               styleClass="dialog-label" text="Message" wrapText="true" />
        <Label fx:id="avatar" alignment="CENTER" styleClass="avatar-label" text="YOU" />
    </children>
</fx:root>
