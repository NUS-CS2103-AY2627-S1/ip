<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="koko.MainWindow"
            prefWidth="500"
            prefHeight="650"
            style="-fx-background-color: #ffffff;">

    <VBox spacing="2"
          AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          style="-fx-padding: 11 16 9 16; -fx-background-color: #0b4f6c;">
        <Label text="Koko the Taskbird"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
        <Label text="Your cheerful task co-pilot"
               style="-fx-text-fill: #dbeafe; -fx-font-size: 11px;" />
    </VBox>

    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                style="-fx-background: #ffffff; -fx-background-color: #ffffff;"
                AnchorPane.topAnchor="58"
                AnchorPane.bottomAnchor="64"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

        <VBox fx:id="dialogContainer"
              spacing="8"
              style="-fx-padding: 12 16 12 16;" />
    </ScrollPane>

    <HBox spacing="8"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          style="-fx-padding: 10 16 12 16; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
        <TextField fx:id="userInput"
                   HBox.hgrow="ALWAYS"
                   maxWidth="1.7976931348623157E308"
                   promptText="Chirp a task: todo read chapter 1"
                   onAction="#handleUserInput"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #cbd5e1; -fx-padding: 8 10 8 10;" />

        <Button fx:id="sendButton"
                text="Fly!"
                onAction="#handleUserInput"
                style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15 8 15;" />
    </HBox>

</AnchorPane>
