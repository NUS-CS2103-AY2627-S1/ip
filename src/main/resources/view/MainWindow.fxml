<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="440.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="minty.ui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="68.0" styleClass="identity-bar"
              AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <ImageView fitWidth="44.0" fitHeight="44.0" preserveRatio="true">
                    <image><Image url="@../images/minty-avatar.png" /></image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label text="Minty" styleClass="identity-title" />
                        <Label text="Your fresh little task buddy" styleClass="identity-subtitle" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="72.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="68.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" id="commandInput" HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput" promptText="What’s next? Try todo read a book" />
                <Button fx:id="sendButton" id="sendButton" defaultButton="true"
                        onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
