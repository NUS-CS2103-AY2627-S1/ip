<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The window is a column: the conversation on top, the input bar below.
  Nothing is placed at fixed coordinates, so when the window is resized the
  conversation takes whatever space is left and the input bar stays put at
  the bottom, however large or small the window becomes.
-->
<VBox prefHeight="600.0" prefWidth="440.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="chione.gui.MainWindow">
    <children>
        <!-- fitToWidth makes the conversation as wide as the window, which is
             what lets long replies re-wrap instead of scrolling sideways. -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="6.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox fx:id="inputBar" alignment="CENTER" spacing="8.0" styleClass="input-bar">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command, then press Enter"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
