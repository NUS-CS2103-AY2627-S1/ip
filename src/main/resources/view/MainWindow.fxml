<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="420.0" minWidth="360.0" prefHeight="600.0" prefWidth="480.0" styleClass="main-window" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gunna.MainWindow">
  <center>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0">
      <content>
        <VBox fx:id="dialogContainer" fillWidth="true" styleClass="dialog-container" />
      </content>
    </ScrollPane>
  </center>
  <bottom>
    <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar">
      <children>
        <TextField fx:id="userInput" HBox.hgrow="ALWAYS" onAction="#handleUserInput" promptText="Enter a command, e.g. todo read chapter 1" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefWidth="72.0" text="Send" />
      </children>
    </HBox>
  </bottom>
</BorderPane>
