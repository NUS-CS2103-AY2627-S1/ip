<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="420.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="zabud.gui.MainWindow">
    <children>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   promptText="Enter a command..."
                   styleClass="command-input"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="76.0" />
        <Button text="Send"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefWidth="76.0"
                styleClass="send-button"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.rightAnchor="0.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="conversation"
                    AnchorPane.bottomAnchor="40.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
