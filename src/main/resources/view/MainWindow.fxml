<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="crystal.gui.MainWindow"
            prefHeight="720.0" prefWidth="560.0"
            stylesheets="@../css/main.css"
            styleClass="app-root">
    <top>
        <VBox spacing="3.0" styleClass="app-header">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
            <Label text="Crystal" styleClass="app-title" />
            <Label text="Your personal task companion • Online" styleClass="app-subtitle" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="messageScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="message-scroll-pane"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="messageContainer" spacing="16.0" styleClass="message-container">
                    <padding>
                        <Insets bottom="20.0" left="18.0" right="18.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox fx:id="messageComposer"
              alignment="CENTER"
              spacing="10.0"
              styleClass="message-composer">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
            <TextField fx:id="commandInput"
                       onAction="#handleUserInput"
                       promptText="Message Crystal…"
                       HBox.hgrow="ALWAYS" />
            <Button defaultButton="true"
                    mnemonicParsing="false"
                    onAction="#handleUserInput"
                    text="Send" />
        </HBox>
    </bottom>
</BorderPane>
