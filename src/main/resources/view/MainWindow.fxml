<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="400.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="meow.MainWindow">

    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="50.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0">
        <VBox fx:id="dialogContainer"
              spacing="8.0"
              styleClass="dialog-container"
              prefWidth="380.0"/>
    </ScrollPane>

    <TextField fx:id="userInput"
               promptText="Type a command..."
               styleClass="input-field"
               onAction="#handleUserInput"
               AnchorPane.bottomAnchor="8.0"
               AnchorPane.leftAnchor="8.0"
               AnchorPane.rightAnchor="90.0"/>

    <Button text="Send"
            styleClass="send-button"
            onAction="#handleUserInput"
            AnchorPane.bottomAnchor="8.0"
            AnchorPane.rightAnchor="8.0"/>
</AnchorPane>
