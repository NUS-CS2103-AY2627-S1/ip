<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="500.0"
            styleClass="root-pane"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jaylen.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="dialog-scroll-pane"
                    AnchorPane.bottomAnchor="58.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0">
                    <padding>
                        <Insets bottom="14.0" left="12.0" right="12.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   promptText="Try: todo submit report"
                   styleClass="command-field"
                   AnchorPane.bottomAnchor="10.0"
                   AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="92.0" />
        <Button defaultButton="true"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefWidth="72.0"
                styleClass="send-button"
                text="Send"
                AnchorPane.bottomAnchor="10.0"
                AnchorPane.rightAnchor="10.0" />
    </children>
</AnchorPane>
