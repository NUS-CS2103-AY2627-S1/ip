<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="650.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="plana.gui.MainWindow">
    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>
    <children>
        <TextField fx:id="userInput"
                   layoutY="606.0"
                   onAction="#handleUserInput"
                   prefHeight="42.0"
                   promptText="Enter a command..."
                   AnchorPane.bottomAnchor="12.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="102.0" />
        <Button fx:id="sendButton"
                layoutX="430.0"
                layoutY="606.0"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="42.0"
                prefWidth="78.0"
                text="Send"
                AnchorPane.bottomAnchor="12.0"
                AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="66.0"
                    AnchorPane.leftAnchor="12.0"
                    AnchorPane.rightAnchor="12.0"
                    AnchorPane.topAnchor="12.0">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
