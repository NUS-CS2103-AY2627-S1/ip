<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="440.0" stylesheets="@../styles/dialog.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fifi.MainWindow">
    <children>
        <VBox spacing="4.0" styleClass="chat-header"
              AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Label text="Fifi" styleClass="title" />
            <Label text="Your tasks, deadlines, and events in one chat." styleClass="subtitle" />
        </VBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    vvalue="1.0" AnchorPane.topAnchor="82.0" AnchorPane.bottomAnchor="72.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="12.0" styleClass="conversation" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" promptText="Type a command, e.g. list" onAction="#handleUserInput"
                   prefHeight="40.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0"
                   AnchorPane.rightAnchor="100.0" />
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" prefHeight="40.0"
                prefWidth="72.0" AnchorPane.bottomAnchor="16.0" AnchorPane.rightAnchor="16.0" />
    </children>
</AnchorPane>
