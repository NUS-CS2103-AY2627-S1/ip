<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="480.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kong.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="62.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="12.0">
                    <padding>
                        <Insets bottom="12.0" left="6.0" right="6.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="42.0"
                           promptText="Inscribe an endeavor (e.g. todo read treatise, list)..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        prefHeight="42.0" prefWidth="76.0" text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
