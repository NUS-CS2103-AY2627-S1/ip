<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity"
            maxWidth="-Infinity"
            minHeight="-Infinity"
            minWidth="-Infinity"
            prefHeight="600.0"
            prefWidth="400.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="zsiggy.MainWindow">

    <children>

        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;"
                    AnchorPane.bottomAnchor="55.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <content>
                <VBox fx:id="dialogContainer"
                      prefWidth="388.0"
                      spacing="2.0"
                      style="-fx-background-color: #F7F8FA;">

                    <padding>
                        <Insets bottom="10.0"
                                left="0.0"
                                right="0.0"
                                top="10.0" />
                    </padding>

                </VBox>
            </content>
        </ScrollPane>

        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="40.0"
                   promptText="Type a command..."
                   style="-fx-background-radius: 8; -fx-font-size: 14px;"
                   AnchorPane.bottomAnchor="7.0"
                   AnchorPane.leftAnchor="8.0"
                   AnchorPane.rightAnchor="85.0" />

        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="40.0"
                prefWidth="70.0"
                style="-fx-background-color: #5C6F68;
                       -fx-background-radius: 8;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;"
                text="Send"
                AnchorPane.bottomAnchor="7.0"
                AnchorPane.rightAnchor="8.0" />

    </children>
</AnchorPane>
