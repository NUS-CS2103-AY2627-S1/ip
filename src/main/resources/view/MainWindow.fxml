<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="460.0"
            style="-fx-background-color: #f7f7f5;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="larry.MainWindow">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              style="-fx-background-color: white; -fx-border-color: #e5e5e3; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="18" bottom="16" left="18"/>
            </padding>

            <Label text="L"
                   alignment="CENTER"
                   minHeight="42"
                   minWidth="42"
                   style="-fx-background-color: #202124; -fx-background-radius: 21; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <VBox spacing="2">
                <Label text="Larry"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #202124;"/>
                <Label text="Your personal task manager"
                       style="-fx-font-size: 11px; -fx-text-fill: #888888;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="● online"
                   style="-fx-font-size: 10px; -fx-text-fill: #888888;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #f7f7f5; -fx-background-color: #f7f7f5; -fx-border-color: transparent;">

            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10"
                      fillWidth="true"
                      style="-fx-background-color: #f7f7f5;">
                    <padding>
                        <Insets top="20" right="18" bottom="20" left="18"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox style="-fx-background-color: white; -fx-border-color: #e5e5e3; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="12" right="14" bottom="14" left="14"/>
            </padding>

            <HBox alignment="CENTER"
                  spacing="8"
                  style="-fx-background-color: #f5f5f3; -fx-background-radius: 18; -fx-padding: 5 6 5 14;">

                <TextField fx:id="userInput"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           prefHeight="38"
                           promptText="Message Larry..."
                           style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-padding: 5 2 5 2;"/>

                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="36"
                        prefWidth="66"
                        text="Send"
                        style="-fx-background-color: #202124; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
