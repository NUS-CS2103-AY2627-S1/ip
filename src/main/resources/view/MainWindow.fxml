<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="panda.app.MainWindow" styleClass="app-root">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="58.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="44.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" fillWidth="true" />
            </content>
        </ScrollPane>
        <CheckBox fx:id="sortByDateCheckBox" text="Sort deadlines by date" onAction="#handleDateSorting"
                  AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
        <Button fx:id="sortDirectionButton" text="Ascending" onAction="#handleSortDirection"
                AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="7.0" />
        <TextField fx:id="userInput" promptText="Type a command..."
                   onAction="#handleUserInput" AnchorPane.bottomAnchor="10.0"
                   AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="88.0" />
        <Button text="Send" onAction="#handleUserInput"
                AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0" />
    </children>
</AnchorPane>
