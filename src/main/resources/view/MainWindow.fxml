<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="460.0" stylesheets="@main.css"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="zhangwei.gui.MainWindow">
   <children>
      <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                  styleClass="chat-scroll" AnchorPane.bottomAnchor="56.0"
                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">
         <content>
            <VBox fx:id="dialogContainer" spacing="10.0" styleClass="chat-area">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
      <TextField fx:id="userInput" onAction="#handleUserInput"
                 promptText="Tell Wei a task, e.g. todo eat bamboo"
                 styleClass="user-input" AnchorPane.bottomAnchor="12.0"
                 AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="92.0" />
      <Button mnemonicParsing="false" onAction="#handleUserInput"
              prefWidth="68.0" styleClass="send-button" text="Send"
              AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="12.0" />
   </children>
</AnchorPane>
