<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="760.0"
      prefWidth="620.0"
      styleClass="main-container"
      stylesheets="@../css/main.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="baby.MainWindow">
    <children>
        <VBox alignment="CENTER" spacing="2.0" styleClass="header-area">
            <children>
                <Label styleClass="header-emblem" text="♕" />
                <Label styleClass="header-title" text="Baby's Winter Court" />
                <Label styleClass="header-subtitle" text="Plan • Organise • Make it Happen" />
                <HBox alignment="CENTER" spacing="8.0" styleClass="header-divider">
                    <children>
                        <Region styleClass="divider-line" HBox.hgrow="ALWAYS" />
                        <Label styleClass="divider-gem" text="◇" />
                        <Region styleClass="divider-line" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="12.0" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="10.0" styleClass="input-area">
            <children>
                <TextField fx:id="userInput"
                           prefHeight="44.0"
                           onAction="#handleUserInput"
                           promptText="Enter a command, Your Highness"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        minWidth="82.0"
                        prefHeight="44.0"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
