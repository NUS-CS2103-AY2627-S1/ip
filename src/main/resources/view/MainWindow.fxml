<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="660.0" prefWidth="465.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="miku.ui.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="3.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0" styleClass="composer">
            <children>
                <TextField fx:id="userInput" accessibleText="Command input" HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput" promptText="Try: todo read notes" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        text="Send ♪" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
