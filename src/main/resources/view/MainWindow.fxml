<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="500.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="trackie.gui.MainWindow">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Type a command..."
                   AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="112.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="42.0" prefWidth="88.0" text="Send"
                AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="62.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" prefWidth="488.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
