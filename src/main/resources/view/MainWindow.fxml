<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="440.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="orbit.MainWindow">
    <children>
        <Label text="Orbit  /  Your task companion" styleClass="window-heading"
               AnchorPane.topAnchor="4.0" AnchorPane.leftAnchor="4.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="56.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="44.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Enter a command..."
                   AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0"
                   AnchorPane.rightAnchor="84.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="10.0" />
    </children>
</AnchorPane>
