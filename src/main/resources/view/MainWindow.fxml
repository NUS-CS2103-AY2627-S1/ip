<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="360.0" minWidth="420.0" prefHeight="640.0" prefWidth="480.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dukey.gui.MainWindow">
    <children>
        <TextField fx:id="userInput" layoutY="594.0" onAction="#handleUserInput"
                   prefHeight="46.0" promptText="Type a command..." AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="84.0" />
        <Button fx:id="sendButton" layoutX="396.0" layoutY="594.0" mnemonicParsing="false"
                onAction="#handleUserInput" prefHeight="46.0" prefWidth="84.0"
                text="Send" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0"
                    prefHeight="594.0" prefWidth="480.0" vvalue="1.0"
                    AnchorPane.bottomAnchor="46.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="594.0" prefWidth="466.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
