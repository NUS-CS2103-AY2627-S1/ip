<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0"
            prefWidth="620.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="quackie.gui.MainWindow">
    <top>
        <VBox spacing="8.0" styleClass="header">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="title" text="QUACKIE" />
                        <Label styleClass="status" text="READY" />
                    </children>
                </HBox>
                <Label styleClass="subtitle" text="Plan it. Do it. Quack on." />
            </children>
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    id="scrollPane"
                    styleClass="conversation">
            <content>
                <VBox fx:id="dialogContainer" id="dialogContainer" spacing="12.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="8.0" styleClass="composer">
            <children>
                <Label fx:id="hintText"
                       styleClass="hint"
                       text="Drop a task in the pond: todo read book  •  list  •  mark 1  •  bye" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <TextField fx:id="userInput"
                                   HBox.hgrow="ALWAYS"
                                   id="userInput"
                                   onAction="#handleUserInput"
                                   promptText="Type a command..." />
                        <Button fx:id="sendButton"
                                defaultButton="true"
                                id="sendButton"
                                onAction="#handleUserInput"
                                text="Send" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="12.0" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>
