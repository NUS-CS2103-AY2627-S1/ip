<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="520.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="glennon.gui.MainWindow">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <top>
                <HBox alignment="CENTER_LEFT" styleClass="header" spacing="12.0">
                    <children>
                        <ImageView fx:id="glennonAvatar" fitWidth="48.0" fitHeight="48.0"
                                   preserveRatio="true" smooth="true" accessibleText="Glennon avatar">
                            <image>
                                <Image url="@../images/glennon-avatar.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="Glennon" styleClass="title" />
                                <Label text="MISSION CONTROL" styleClass="subtitle" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </top>
            <center>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" minWidth="0.0"
                            minHeight="0.0" focusTraversable="true" accessibleText="Conversation history">
                    <content>
                        <VBox fx:id="dialogContainer" styleClass="conversation" minWidth="0.0" />
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <VBox fx:id="composer" styleClass="composer" spacing="10.0" minWidth="0.0">
                    <children>
                        <HBox spacing="8.0" alignment="CENTER_LEFT" minWidth="0.0">
                            <children>
                                <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="44.0"
                                           minWidth="0.0" HBox.hgrow="ALWAYS"
                                           promptText="Try: todo read a book" accessibleText="Mission command" />
                                <Button fx:id="sendButton" onAction="#handleUserInput" text="Send"
                                        mnemonicParsing="false" prefHeight="44.0" minWidth="72.0" />
                            </children>
                        </HBox>
                        <Label text="todo · deadline · event · list · sort · find · on · mark · unmark · delete · bye"
                               styleClass="command-hint" wrapText="true" minWidth="0.0"
                               minHeight="-Infinity" maxWidth="Infinity" />
                    </children>
                </VBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
