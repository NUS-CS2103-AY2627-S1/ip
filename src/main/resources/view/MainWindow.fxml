<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bkxss.MainWindow"
            styleClass="app-root">
    <top>
        <VBox spacing="3.0" styleClass="header">
            <Label text="Bkxss" styleClass="app-title" />
            <Label text="Your task housekeeper, at your service!" styleClass="muted-text" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="conversationScroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="conversation-scroll">
            <content>
                <VBox fx:id="conversation" spacing="16.0" styleClass="conversation" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="8.0" styleClass="composer">
            <HBox alignment="CENTER" spacing="10.0">
                <TextField fx:id="commandInput"
                           accessibleText="Command"
                           minWidth="0.0"
                           onAction="#sendCommand"
                           promptText="e.g. todo borrow book"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        minWidth="-Infinity"
                        onAction="#sendCommand"
                        text="Send" />
            </HBox>
            <Label text="Enter to send · list to view tasks · bye to finish"
                   wrapText="true"
                   styleClass="input-hint" />
        </VBox>
    </bottom>
</BorderPane>
