<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="360.0" minWidth="320.0" prefHeight="600.0" prefWidth="400.0"
            stylesheets="@../styles/peter-theme.css" styleClass="main-window"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="peter.gui.MainWindow">
  <center>
    <!-- fitToWidth lets every dialog track the available window width, while
         the vertical scroll bar appears only when the transcript needs it. -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
      <content>
        <VBox fx:id="dialogContainer" fillWidth="true" spacing="2.0"
              styleClass="dialog-container" />
      </content>
    </ScrollPane>
  </center>
  <bottom>
    <!-- Both the text field and the button call the same handler, so Enter and
         a click send a command in exactly the same way. -->
    <HBox alignment="CENTER" spacing="8.0" styleClass="command-bar"
          BorderPane.alignment="CENTER">
      <children>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Enter a command..." HBox.hgrow="ALWAYS" />
        <Button fx:id="sendButton" mnemonicParsing="false"
                onAction="#handleUserInput" text="Send" />
      </children>
      <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
      </padding>
    </HBox>
  </bottom>
</BorderPane>
