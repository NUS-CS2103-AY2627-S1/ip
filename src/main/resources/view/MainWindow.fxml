<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<!--        Use the MainWindow Java class to control this FXML window-->
<AnchorPane fx:id="mainPane" minHeight="500.0" minWidth="420.0"
            style="-fx-background-color: white;"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="benji.MainWindow">
    <children>
        <StackPane fx:id="headerPane" prefHeight="60.0"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">
            <Button fx:id="helpButton"
                    text="How to use BENJI?"
                    onAction="#showHelp"
                    style="-fx-background-color: white;
                           -fx-border-color: #D1D5DB;
                           -fx-border-radius: 8;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;"/>
        </StackPane>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.topAnchor="60.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="70.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10.0"
                      style="-fx-padding: 8.0;"/>
            </content>
        </ScrollPane>

        <AnchorPane fx:id="footerPane" prefHeight="70.0"
                    style="-fx-background-color: white; -fx-border-color: #D1D5DB;"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0">
            <children>
                <TextField fx:id="userInput"
                           promptText="Type a command here..."
                           onAction="#handleUserInput"
                           AnchorPane.topAnchor="12.0"
                           AnchorPane.leftAnchor="12.0"
                           AnchorPane.rightAnchor="102.0"
                           AnchorPane.bottomAnchor="12.0"/>

                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#handleUserInput"
                        prefWidth="90.0"
                        style="-fx-background-color: #2563EB;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;"
                        AnchorPane.topAnchor="12.0"
                        AnchorPane.rightAnchor="12.0"
                        AnchorPane.bottomAnchor="12.0"/>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
