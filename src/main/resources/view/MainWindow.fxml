<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!--
  A VBox of two rows rather than an AnchorPane of pinned coordinates. The old
  layout fixed its own size, which is what stopped the window being resized; here
  the transcript takes whatever height is left over and the input bar keeps its own,
  so the window can be dragged to any size and the content follows.
-->
<VBox prefHeight="560.0" prefWidth="420.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bucket.MainWindow">
    <children>
        <!-- fitToWidth lets each message wrap to the window instead of scrolling sideways. -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>

        <HBox fx:id="inputBar" styleClass="input-bar" alignment="CENTER">
            <children>
                <!-- The field absorbs the spare width so the button stays its natural size. -->
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command, e.g. list"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
