<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="520.0" stylesheets="@trybot.css" styleClass="app"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="trybot.gui.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    minWidth="0.0" minHeight="0.0" styleClass="conversation"
                    accessibleText="Conversation with TryBot">
            <content>
                <VBox fx:id="dialogContainer" minWidth="0.0" spacing="16.0" styleClass="messages" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="10.0" styleClass="composer">
            <FlowPane fx:id="suggestions" hgap="8.0" vgap="6.0">
                <Button text="+ Add a task" onAction="#handleAddTask" styleClass="suggestion" />
                <Button text="My list" onAction="#handleList" styleClass="suggestion" />
                <Button text="Commands" onAction="#handleHelp" styleClass="suggestion" />
            </FlowPane>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <TextField fx:id="userInput" onAction="#handleUserInput" minWidth="0.0"
                           promptText="Try: todo read a chapter" HBox.hgrow="ALWAYS"
                           accessibleText="Command" />
                <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"
                        minWidth="68.0" styleClass="send-button" />
            </HBox>
            <Label fx:id="inputHint" text="Enter to send · Add a task, date, or tag at your own pace"
                   wrapText="true" minHeight="-Infinity" styleClass="input-hint" />
        </VBox>
    </bottom>
</BorderPane>
