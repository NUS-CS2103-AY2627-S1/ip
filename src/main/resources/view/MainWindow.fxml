<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="700.0" prefWidth="520.0" styleClass="main-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="samantha.ui.MainWindow">
    <children>
        <AnchorPane styleClass="conversation-frame" AnchorPane.bottomAnchor="20.0"
                    AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
                    AnchorPane.topAnchor="20.0">
            <children>
                <Label alignment="CENTER" styleClass="samantha-title" text="Samantha"
                       AnchorPane.leftAnchor="32.0" AnchorPane.rightAnchor="32.0"
                       AnchorPane.topAnchor="24.0" />
                <Button fx:id="helpButton" mnemonicParsing="false" onAction="#openHelpFromButton"
                        styleClass="help-affordance" text="?"
                        AnchorPane.rightAnchor="28.0" AnchorPane.topAnchor="22.0">
                    <tooltip>
                        <Tooltip text="Command guide" />
                    </tooltip>
                </Button>
                <Region styleClass="title-divider" AnchorPane.leftAnchor="44.0"
                        AnchorPane.rightAnchor="44.0" AnchorPane.topAnchor="72.0" />
                <Region styleClass="corner corner-top-left" AnchorPane.leftAnchor="20.0"
                        AnchorPane.topAnchor="20.0" />
                <Region styleClass="corner corner-bottom-right" AnchorPane.bottomAnchor="20.0"
                        AnchorPane.rightAnchor="20.0" />
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                            AnchorPane.bottomAnchor="70.0" AnchorPane.leftAnchor="28.0"
                            AnchorPane.rightAnchor="28.0" AnchorPane.topAnchor="88.0">
                    <content>
                        <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0"
                              styleClass="dialog-container" />
                    </content>
                </ScrollPane>
                <AnchorPane styleClass="composer" AnchorPane.bottomAnchor="18.0"
                            AnchorPane.leftAnchor="28.0" prefHeight="40.0"
                            AnchorPane.rightAnchor="28.0">
                    <children>
                        <TextField fx:id="userInput" onAction="#handleUserInput"
                                   promptText="Talk to Samantha…" AnchorPane.bottomAnchor="0.0"
                                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="54.0"
                                   AnchorPane.topAnchor="0.0" />
                        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                                text="↑" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0"
                                AnchorPane.topAnchor="0.0" />
                    </children>
                </AnchorPane>
            </children>
        </AnchorPane>
    </children>
    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>
</AnchorPane>
