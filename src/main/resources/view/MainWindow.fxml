<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="520.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lenzabot.gui.MainWindow">
    <children>
        <VBox prefHeight="680.0" prefWidth="520.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="76.0" styleClass="header">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="title" text="LENZABOT"/>
                                <Label styleClass="subtitle" text="Task desk / ready for commands"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0"
                              styleClass="dialog-container"/>
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" spacing="10.0" styleClass="composer">
                    <children>
                        <TextField fx:id="userInput" onAction="#handleUserInput"
                                   promptText="e.g. todo read a book" HBox.hgrow="ALWAYS"/>
                        <Button defaultButton="true" onAction="#handleUserInput" text="SEND"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
