<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The conversation above, the input bar below. The conversation takes all the
  height the bar leaves, and the text field all the width the button leaves,
  so both follow the window when it is resized.
-->
<VBox prefHeight="600.0" prefWidth="420.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alfred.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="2.0">
                    <padding>
                        <Insets bottom="8.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox fx:id="inputBar" alignment="CENTER" spacing="8.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="How may I be of service, sir? Try list"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        defaultButton="false"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0" />
            </padding>
        </HBox>
    </children>
    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>
</VBox>
