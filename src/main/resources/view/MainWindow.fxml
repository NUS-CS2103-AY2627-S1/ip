<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="520.0" minWidth="400.0" prefHeight="640.0" prefWidth="460.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vega.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="2.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" styleClass="command-input"
                   promptText="Enter a command..."
                   AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0"
                   AnchorPane.rightAnchor="86.0" />
        <Button fx:id="sendButton" onAction="#handleUserInput" styleClass="send-button" text="Send"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="8.0" />
    </children>
</AnchorPane>
