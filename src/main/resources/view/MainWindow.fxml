<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="700.0"
            stylesheets="@blud.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="blud.ui.MainWindow">
    <top>
        <VBox styleClass="header">
            <Label text="Blud" styleClass="title" />
            <Label text="Your friendly task companion" styleClass="subtitle" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                    styleClass="conversation-scroll">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0" fillWidth="true" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10.0" styleClass="input-row">
            <TextField fx:id="userInput" promptText="Type a command..." onAction="#handleUserInput"
                       maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" text="Send" defaultButton="true" onAction="#handleUserInput" />
            <padding>
                <Insets top="14.0" right="18.0" bottom="18.0" left="18.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
