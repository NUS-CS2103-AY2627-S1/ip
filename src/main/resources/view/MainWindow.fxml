<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane minHeight="450.0" minWidth="420.0" prefHeight="600.0" prefWidth="420.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="genie.ui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT" maxHeight="72.0" minHeight="72.0" prefHeight="72.0"
              styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true"
                       styleClass="header-avatar">
                <image>
                    <Image url="@../images/genie.png" />
                </image>
                <clip>
                    <Circle centerX="21.0" centerY="21.0" radius="21.0" />
                </clip>
            </ImageView>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="header-title" text="Genie" />
                <Label styleClass="header-subtitle" text="Your task concierge" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="5.0">
                <Label styleClass="header-status-dot" text="●" />
                <Label styleClass="header-status" text="Ready" />
            </HBox>
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
            </padding>
        </HBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="68.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="72.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" maxHeight="68.0" minHeight="68.0" prefHeight="68.0"
              styleClass="input-bar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0"
                       promptText="Enter a command..." HBox.hgrow="ALWAYS" />
            <Button onAction="#handleUserInput" mnemonicParsing="false"
                    prefHeight="48.0" prefWidth="92.0" text="Send" />
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="8.0" />
            </padding>
        </HBox>
    </children>
</AnchorPane>
