<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="640.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alfred.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="665.0"
                    prefWidth="640.0" vvalue="1.0" AnchorPane.bottomAnchor="55.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="660.0" prefWidth="628.0" spacing="4.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" layoutY="667.0" onAction="#handleUserInput" prefHeight="53.0"
                   prefWidth="540.0" promptText="Enter a command..." AnchorPane.bottomAnchor="1.0"
                   AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="100.0" />
        <Button layoutX="548.0" layoutY="667.0" mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="53.0" prefWidth="84.0" text="Send" AnchorPane.bottomAnchor="1.0"
                AnchorPane.rightAnchor="0.0" />
    </children>
</AnchorPane>
