<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="560.0" styleClass="cosmos"
            stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="sophon.ui.MainWindow">
    <children>
        <VBox styleClass="title-panel" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <Label styleClass="app-title" text="S O P H O N" />
            <Label styleClass="app-subtitle" text="智子 · LISTENING BEYOND THE STARS" />
        </VBox>

        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true"
                    styleClass="conversation-scroll" vbarPolicy="AS_NEEDED" vvalue="1.0"
                    AnchorPane.bottomAnchor="76.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="86.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="4.0" styleClass="dialog-container" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="10.0" styleClass="composer"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS" onAction="#handleUserInput"
                       promptText="Transmit a message into the universe…" styleClass="message-input" />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                    styleClass="send-button" text="TRANSMIT" />
        </HBox>
    </children>
</AnchorPane>
