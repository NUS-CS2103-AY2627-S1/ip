<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="820.0" prefWidth="620.0"
            styleClass="app-shell"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dobby.ui.gui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT"
              prefHeight="64.0"
              spacing="10.0"
              styleClass="header-bar"
              AnchorPane.leftAnchor="14.0"
              AnchorPane.rightAnchor="14.0"
              AnchorPane.topAnchor="14.0">
            <padding>
                <Insets left="18.0" right="18.0" />
            </padding>
            <children>
                <Label styleClass="brand-icon" text="🧦" />
                <Label styleClass="header-title" text="KNOCK KNOCK" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label styleClass="system-badge" text="DOBBY OS" />
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT"
              prefHeight="48.0"
              spacing="9.0"
              styleClass="contact-bar"
              AnchorPane.leftAnchor="18.0"
              AnchorPane.rightAnchor="18.0"
              AnchorPane.topAnchor="88.0">
            <padding>
                <Insets left="14.0" right="14.0" />
            </padding>
            <children>
                <Label styleClass="chat-icon" text="🗨" />
                <Label styleClass="contact-name" text="Dobby" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label styleClass="online-label" text="ONLINE" />
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="chat-panel"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="84.0"
                    AnchorPane.leftAnchor="18.0"
                    AnchorPane.rightAnchor="18.0"
                    AnchorPane.topAnchor="142.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="2.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="52.0"
                   promptText="Tell Dobby what to do"
                   styleClass="composer-field"
                   AnchorPane.bottomAnchor="18.0"
                   AnchorPane.leftAnchor="18.0"
                   AnchorPane.rightAnchor="120.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="52.0"
                prefWidth="92.0"
                styleClass="send-button"
                text="Send"
                AnchorPane.bottomAnchor="18.0"
                AnchorPane.rightAnchor="18.0" />
    </children>
</AnchorPane>
