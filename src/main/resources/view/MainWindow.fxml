<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="480.0"
            prefHeight="650.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="will.gui.MainWindow"
            styleClass="root-pane">
    <children>
        <VBox alignment="CENTER_LEFT" prefHeight="52.0" styleClass="header-bar"
              AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Label text="Will" styleClass="header-title" />
            </children>
        </VBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="chat-scroll"
                    AnchorPane.topAnchor="52.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="60.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0" styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0" prefHeight="60.0" styleClass="input-bar"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" promptText="Type a message..." HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput" styleClass="input-field" />
                <Button fx:id="sendButton" mnemonicParsing="false" text="Send"
                        onAction="#handleUserInput" styleClass="send-button" />
            </children>
        </HBox>
    </children>
</AnchorPane>
