<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="280.0" minWidth="340.0"
            prefHeight="560.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="ekud.ui.MainWindow">
  <children>
    <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="36.0"
               promptText="Type a command, or help"
               AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="10.0"
               AnchorPane.rightAnchor="86.0" />
    <Button fx:id="sendButton" mnemonicParsing="false"
            onAction="#handleUserInput" prefHeight="36.0" prefWidth="68.0" text="Send"
            AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="10.0" />
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0"
                vvalue="1.0" AnchorPane.bottomAnchor="52.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <content>
        <VBox fx:id="dialogContainer" spacing="4.0">
          <padding>
            <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
          </padding>
        </VBox>
      </content>
    </ScrollPane>
  </children>
  <stylesheets>
    <URL value="@../css/main.css" />
  </stylesheets>
</AnchorPane>
