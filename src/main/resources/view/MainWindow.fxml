<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!-- Root layout for the chat window; wired to food.MainWindow. -->
<AnchorPane maxHeight="600.0" maxWidth="400.0" minHeight="600.0" minWidth="400.0" prefHeight="600.0"
            prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="food.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" prefHeight="600.0" prefWidth="400.0"
                    AnchorPane.bottomAnchor="55.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0"
                    AnchorPane.topAnchor="1.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="562.0" prefWidth="384.0">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Order up!"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0"/>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefWidth="310.0"
                   promptText="What's the order, chef?"
                   AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"/>
    </children>
</AnchorPane>
