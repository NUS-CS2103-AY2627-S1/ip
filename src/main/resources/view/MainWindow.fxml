<?xml version="1.0" encoding="UTF-8"?>

<?import duchess.gui.Composer?>
<?import duchess.gui.ConversationView?>
<?import duchess.gui.Header?>
<?import duchess.gui.QuickCommands?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="680.0" prefWidth="520.0" minHeight="560.0" minWidth="420.0" spacing="0.0" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="duchess.gui.MainWindow"
      styleClass="app-shell">
    <children>
        <Header fx:id="header" />
        <QuickCommands fx:id="quickCommands">
            <VBox.margin>
                <Insets bottom="6.0" left="14.0" right="14.0" top="10.0" />
            </VBox.margin>
        </QuickCommands>
        <ConversationView fx:id="conversationView" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets left="12.0" right="12.0" />
            </VBox.margin>
        </ConversationView>
        <Composer fx:id="composer">
            <VBox.margin>
                <Insets bottom="14.0" left="14.0" right="14.0" top="8.0" />
            </VBox.margin>
        </Composer>
    </children>
</VBox>
