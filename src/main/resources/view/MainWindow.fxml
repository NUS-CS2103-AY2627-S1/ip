<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="320.0" minWidth="320.0" prefHeight="600.0" prefWidth="430.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="atom.ui.MainWindow">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Try: todo water the plants" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="88.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send  ➜" AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="10.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0" AnchorPane.bottomAnchor="58.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
