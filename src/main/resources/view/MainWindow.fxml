<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The layout of the chat window. Everything here could have been written in Java, but keeping
  it in FXML separates what the window looks like from what it does: the sizes and positions
  below can be changed without recompiling, and the controller named by fx:controller holds
  only behavior.

  A VBox, not an AnchorPane. An AnchorPane positions its children at fixed distances from the
  edges, which meant every size had to be stated twice - once here and once again whenever the
  window changed size. A VBox simply stacks its children top to bottom, and VBox.vgrow="ALWAYS"
  on the scroll pane says which one absorbs the spare height. Resizing the window then works by
  itself: the conversation grows, and the input bar stays its natural height at the bottom.

  The stylesheet is attached here rather than in Main.java so that the whole appearance of the
  window is described by this file and the one it points at. "@" makes the path relative to
  this file's own location.
-->
<VBox maxHeight="Infinity" maxWidth="Infinity"
      minHeight="320.0" minWidth="300.0"
      prefHeight="600.0" prefWidth="420.0"
      styleClass="root-pane"
      stylesheets="@../css/main.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="shannon.gui.MainWindow">
    <children>
        <!--
          fitToWidth="true" makes the conversation exactly as wide as the visible area, so the
          bubbles re-wrap when the window is resized instead of being scrolled sideways to.
          That, with hbarPolicy="NEVER", is what removes horizontal scrolling entirely.
        -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="chat-scroll"
                    vvalue="1.0"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>

        <!--
          onAction="#handleUserInput" is what connects pressing Enter, and the Send
          button, to the method of that name in MainWindow.

          HBox.hgrow="ALWAYS" on the text field gives it all the width the button does not
          need, so widening the window widens the place you type rather than leaving a gap.
        -->
        <HBox alignment="CENTER" styleClass="input-bar">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo read book"
                           styleClass="input-field"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        styleClass="send-button"
                        text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
