<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="460.0"
            stylesheets="@Kaya.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kaya.ui.MainWindow">
    <top>
        <VBox spacing="3.0" styleClass="app-header">
            <Label text="Kaya" styleClass="app-title" />
            <Label text="Your kopitiam companion" styleClass="app-subtitle" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    minWidth="0.0"
                    styleClass="chat-scroll">
            <content>
                <VBox fx:id="dialogContainer" minWidth="0.0" spacing="18.0" styleClass="chat-history" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="9.0" styleClass="composer">
            <HBox alignment="CENTER" spacing="10.0">
                <TextField fx:id="userInput"
                           minWidth="0.0"
                           onAction="#handleUserInput"
                           promptText="Enter a command..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        defaultButton="true"
                        minWidth="76.0"
                        onAction="#handleUserInput"
                        text="Send" />
            </HBox>
            <Label text="Try: todo read a book · list · find book"
                   minHeight="-Infinity"
                   styleClass="command-hint"
                   wrapText="true" />
        </VBox>
    </bottom>
</BorderPane>
