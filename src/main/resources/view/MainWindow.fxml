<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="720.0"
            prefWidth="540.0"
            minHeight="550.0"
            minWidth="420.0"
            stylesheets="@../style.css"
            styleClass="main-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kiaw.ui.MainWindow">

    <children>

        <VBox AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="16.0"
                      prefHeight="104.0"
                      styleClass="header">

                    <padding>
                        <Insets top="18.0"
                                right="26.0"
                                bottom="18.0"
                                left="26.0" />
                    </padding>

                    <children>

                        <StackPane minHeight="58.0"
                                   minWidth="58.0"
                                   prefHeight="58.0"
                                   prefWidth="58.0"
                                   maxHeight="58.0"
                                   maxWidth="58.0"
                                   styleClass="header-avatar">

                            <children>

                                <Circle radius="29.0"
                                        styleClass="header-avatar-circle" />

                                <Label text="✦"
                                       styleClass="header-avatar-icon" />

                            </children>

                        </StackPane>

                        <VBox alignment="CENTER_LEFT"
                              spacing="3.0">

                            <children>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="10.0">

                                    <children>

                                        <Label text="Kiaw"
                                               styleClass="header-title" />

                                        <Label text="ONLINE"
                                               styleClass="online-badge" />

                                    </children>

                                </HBox>

                                <Label text="Task Assistant"
                                       styleClass="header-subtitle" />

                                <Label text="Stay organised. Get things done."
                                       styleClass="header-tagline" />

                            </children>

                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                    </children>

                </HBox>

                <ScrollPane fx:id="scrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS"
                            styleClass="chat-scroll-pane">

                    <content>

                        <VBox fx:id="dialogContainer"
                              fillWidth="true"
                              spacing="5.0"
                              styleClass="dialog-container">

                            <padding>
                                <Insets top="15.0"
                                        right="10.0"
                                        bottom="15.0"
                                        left="10.0" />
                            </padding>

                        </VBox>

                    </content>

                </ScrollPane>

                <VBox spacing="7.0"
                      styleClass="composer">

                    <padding>
                        <Insets top="10.0"
                                right="14.0"
                                bottom="10.0"
                                left="14.0" />
                    </padding>

                    <children>

                        <HBox alignment="CENTER"
                              spacing="10.0">

                            <children>

                                <TextField fx:id="userInput"
                                           onAction="#handleUserInput"
                                           promptText="Type a command..."
                                           HBox.hgrow="ALWAYS"
                                           styleClass="user-input" />

                                <Button fx:id="sendButton"
                                        mnemonicParsing="false"
                                        onAction="#handleUserInput"
                                        text="Send"
                                        styleClass="send-button" />

                            </children>

                        </HBox>

                        <Label text="Try: todo  •  deadline  •  event  •  list  •  find  •  sort"
                               styleClass="command-hint" />

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
