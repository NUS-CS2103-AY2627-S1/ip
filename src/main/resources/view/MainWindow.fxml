<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" styleClass="mission-control" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="echo.ui.components.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="8.0" styleClass="mission-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label styleClass="mission-title" text="ECHO // MISSION CONTROL" />
                <Region HBox.hgrow="ALWAYS" />
                <Circle fill="#58D68D" radius="4.0" />
                <Label styleClass="online-status" text="ONLINE" />
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0" AnchorPane.bottomAnchor="64.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="48.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="2.0" styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" prefHeight="64.0" spacing="10.0" styleClass="input-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Transmit a command…" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefWidth="76.0" text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
