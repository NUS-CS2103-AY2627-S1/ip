<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="500.0"
            prefHeight="720.0" prefWidth="620.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="shrek.MainWindow">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Enter a command, e.g. todo learn JavaFX"
                   prefHeight="44.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="100.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="44.0" prefWidth="84.0" text="Send"
                AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    prefHeight="630.0" prefWidth="596.0" vbarPolicy="AS_NEEDED"
                    AnchorPane.bottomAnchor="70.0" AnchorPane.leftAnchor="12.0"
                    AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" maxWidth="1.7976931348623157E308"
                      minWidth="0.0" prefWidth="570.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
