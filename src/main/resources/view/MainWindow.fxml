<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            styleClass="chat-root"
            stylesheets="@puke.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="puke.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" />
            </content>
            <AnchorPane.bottomAnchor>42.0</AnchorPane.bottomAnchor>
            <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
            <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
            <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Enter a command"
                   AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="77.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0" />
    </children>
</AnchorPane>
