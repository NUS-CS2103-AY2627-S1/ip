<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- A BorderPane rather than fixed anchors, so the conversation takes whatever
     room the window has and the input row stretches with it on resize. -->
<BorderPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sallman.gui.MainWindow">
    <!-- An assistant-app header: who you are talking to, and that it is keen to help. -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header">
            <children>
                <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/sallman.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="brand" text="saLLMan" />
                        <Label styleClass="status" text="Online · always eager to help" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="8.0" left="12.0" right="12.0" top="8.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <!-- Not focus-traversable, so typing goes straight to the input box. -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    focusTraversable="false"
                    hbarPolicy="NEVER"
                    vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox alignment="CENTER" spacing="6.0" styleClass="input-bar">
            <children>
                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <TextField fx:id="userInput"
                                   onAction="#handleUserInput"
                                   promptText="Message saLLMan..."
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton"
                                minWidth="-Infinity"
                                mnemonicParsing="false"
                                onAction="#handleUserInput"
                                text="Send" />
                    </children>
                </HBox>
                <!-- The disclaimer every AI assistant carries, played straight. -->
                <Label styleClass="disclaimer" text="saLLMan can make mistakes. Check important tasks." />
            </children>
            <padding>
                <Insets bottom="6.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </bottom>
    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>
</BorderPane>
