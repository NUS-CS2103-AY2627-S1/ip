<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<BorderPane prefHeight="700.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="charliek.ui.MainWindow">
    <center>
        <StackPane styleClass="chat-area">
            <VBox alignment="CENTER" mouseTransparent="true" spacing="4.0" styleClass="chat-watermark">
                <Label styleClass="watermark-title" text="CHARLIEK" />
                <Label styleClass="watermark-tagline" text="America's #1 task manager*" />
                <Label styleClass="watermark-footnote" text="*citation needed" />
            </VBox>
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        styleClass="chat-scroll-pane">
                <content>
                    <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0" styleClass="dialog-container">
                        <padding>
                            <Insets bottom="16.0" left="12.0" right="12.0" top="16.0" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <HBox spacing="8.0" styleClass="input-bar">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Enter a command..."
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
