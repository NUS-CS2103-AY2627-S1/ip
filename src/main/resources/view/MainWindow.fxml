<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane minHeight="600.0" minWidth="560.0"
            prefHeight="720.0" prefWidth="760.0"
            styleClass="app-shell"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="zucc.ui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="app-header">
            <padding>
                <Insets bottom="18.0" left="28.0" right="28.0" top="18.0" />
            </padding>
            <StackPane styleClass="brand-mark">
                <Label styleClass="brand-letter" text="Z" />
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="brand-name" text="ZUCC" />
                <Label styleClass="brand-tagline" text="Your tasks, connected" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="7.0" styleClass="status-pill">
                <Circle fx:id="statusDot" radius="4.0" styleClass="status-dot" />
                <Label fx:id="statusLabel" styleClass="status-label" text="READY" />
            </HBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    hbarPolicy="NEVER" pannable="true"
                    styleClass="conversation-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true"
                      spacing="18.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="30.0" left="28.0" right="28.0" top="30.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="12.0" styleClass="composer">
            <padding>
                <Insets bottom="22.0" left="28.0" right="28.0" top="18.0" />
            </padding>
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                       onAction="#handleUserInput"
                       promptText="Type a command — try ‘list’"
                       styleClass="command-input" />
            <Button fx:id="sendButton" mnemonicParsing="false"
                    onAction="#handleUserInput" styleClass="send-button"
                    text="Send  →" />
        </HBox>
    </bottom>
</BorderPane>
