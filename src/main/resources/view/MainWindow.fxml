<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="420.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="neil.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    AnchorPane.bottomAnchor="60.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="4.0" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER"
              spacing="8.0"
              styleClass="composer-bar"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput"
                           maxWidth="1.7976931348623157E308"
                           onAction="#handleUserInput"
                           onKeyPressed="#handleHistoryNavigation"
                           promptText="Type a command... (Up/Down for history)"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        minWidth="72.0"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="40.0"
                        prefWidth="72.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
