<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            minHeight="420.0"
            minWidth="480.0"
            prefHeight="720.0"
            prefWidth="920.0"
            stylesheets="@../css/main.css"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nori.ui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="app-header">
            <padding>
                <Insets bottom="16.0" left="26.0" right="26.0" top="16.0" />
            </padding>
            <StackPane fx:id="logoSlot" minHeight="50.0" minWidth="50.0" />
            <VBox alignment="CENTER_LEFT" spacing="1.0">
                <Label styleClass="brand-name" text="NORI" />
                <Label styleClass="brand-tagline" text="Tiny flippers. Big plans." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="7.0" styleClass="status-pill">
                <Label styleClass="status-dot" text="●" />
                <Label fx:id="statusLabel" styleClass="status-text" text="Ready to noot" />
            </HBox>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="conversation-shell">
            <padding>
                <Insets bottom="8.0" left="22.0" right="22.0" top="18.0" />
            </padding>
            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        pannable="true"
                        styleClass="conversation-scroll"
                        vbarPolicy="AS_NEEDED">
                <content>
                    <VBox fx:id="dialogContainer"
                          fillWidth="true"
                          minHeight="-Infinity"
                          spacing="18.0"
                          styleClass="dialog-container">
                        <padding>
                            <Insets bottom="22.0" left="8.0" right="8.0" top="8.0" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <VBox spacing="9.0" styleClass="composer-shell">
            <padding>
                <Insets bottom="20.0" left="28.0" right="28.0" top="14.0" />
            </padding>
            <HBox fx:id="composerBar" alignment="CENTER" spacing="10.0" styleClass="composer-bar">
                <TextField fx:id="userInput"
                           accessibleHelp="Enter a Nori command"
                           onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo finish CS2103 tutorial"
                           styleClass="command-input"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        accessibleText="Send command"
                        defaultButton="true"
                        onAction="#handleUserInput"
                        styleClass="send-button"
                        text="Send  ➜" />
            </HBox>
            <Label styleClass="composer-hint"
                   text="Enter sends  •  ↑ ↓ recall earlier commands  •  help lists them  •  bye closes" />
        </VBox>
    </bottom>
</BorderPane>
