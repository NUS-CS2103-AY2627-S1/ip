<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="680.0" prefWidth="420.0" minWidth="0.0"
 stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17"
 xmlns:fx="http://javafx.com/fxml/1" fx:controller="panda.gui.MainWindow">
 <top>
  <StackPane styleClass="app-header">
  <HBox styleClass="header-bubble" spacing="12.0" alignment="CENTER_LEFT">
   <StackPane styleClass="header-avatar-frame" minWidth="64.0" maxWidth="64.0"
              minHeight="64.0" maxHeight="64.0">
    <ImageView fx:id="headerAvatar" fitWidth="60.0" fitHeight="60.0" preserveRatio="true" />
   </StackPane>
   <VBox HBox.hgrow="ALWAYS" minWidth="0.0">
    <Label text="Panda" styleClass="app-title" />
    <Label text="Your little task companion" styleClass="app-subtitle" wrapText="true" />
   </VBox>
  </HBox>
  </StackPane>
 </top>
 <center>
  <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" minWidth="0.0">
   <content><VBox fx:id="dialogContainer" minWidth="0.0" fillWidth="true" spacing="6.0" /></content>
  </ScrollPane>
 </center>
 <bottom>
  <VBox fx:id="composer">
   <Label fx:id="inputFeedback" visible="false" managed="false" wrapText="true" styleClass="input-error" />
  <HBox styleClass="input-bar" spacing="8.0" alignment="CENTER">
   <TextField fx:id="userInput" onAction="#handleUserInput" minWidth="0.0"
    promptText="Tell Panda what to do..." HBox.hgrow="ALWAYS" />
   <Button fx:id="sendButton" onAction="#handleUserInput" text="↑" accessibleText="Send command"
    minWidth="44.0" prefWidth="44.0" maxWidth="44.0" />
  </HBox>
  </VBox>
 </bottom>
</BorderPane>
