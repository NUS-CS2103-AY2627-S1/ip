<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane minHeight="420.0" minWidth="420.0" prefHeight="600.0" prefWidth="720.0"
            styleClass="main-window" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="nutrisoy.ui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-header">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Text styleClass="app-title" text="SOYA ✦" />
                        <Text styleClass="app-subtitle" text="NutriSoy · Your sassy task sidekick" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="app-badge" text="SERVING TASKS" />
            </children>
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true"
                    styleClass="conversation-scroll">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="5.0" styleClass="composer">
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <TextField fx:id="userInput" onAction="#handleUserInput"
                                   promptText="Drop a command -- I can handle it"
                                   styleClass="command-input" HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false"
                                onAction="#handleUserInput" styleClass="send-button" text="Do it" />
                    </children>
                </HBox>
                <Text fx:id="statusText" styleClass="status-text" text="Ready to serve" />
            </children>
            <padding>
                <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>
