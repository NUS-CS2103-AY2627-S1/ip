<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            minWidth="340" minHeight="220" prefWidth="400" prefHeight="600"
            fx:controller="lebron.MainWindow">
    <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" fitToWidth="true"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="58.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <VBox fx:id="dialogContainer" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </ScrollPane>

    <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command..."
               AnchorPane.leftAnchor="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="80.0"/>

    <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"
            AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0"/>
</AnchorPane>
