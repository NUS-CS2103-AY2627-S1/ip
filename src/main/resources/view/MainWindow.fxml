<AnchorPane minHeight="260.0" minWidth="320.0" prefHeight="600.0" prefWidth="450.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="student.project.bob.fx.MainWindow">
