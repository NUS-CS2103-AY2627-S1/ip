<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="320.0" minWidth="480.0"
            prefHeight="640.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tem.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="10.0" styleClass="app-header"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <StackPane prefHeight="36.0" prefWidth="36.0" styleClass="header-avatar">
                    <children>
                        <Label styleClass="header-avatar-initial" text="T" />
                    </children>
                </StackPane>
                <VBox minWidth="0.0" spacing="1.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="chat-title" text="Tem" />
                        <Label styleClass="chat-subtitle" text="Your task companion" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="ALWAYS"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="88.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="64.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10.0" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" prefHeight="56.0" spacing="8.0" styleClass="composer"
              AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           prefHeight="44.0"
                           promptText="Message Tem..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="40.0"
                        prefWidth="72.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
