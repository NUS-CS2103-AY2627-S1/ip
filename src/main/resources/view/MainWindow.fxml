<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="michael.MainWindow" styleClass="space-window">
    <children>
        <ImageView mouseTransparent="true" preserveRatio="false"
                   AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <image><Image url="/space-background.png" /></image>
        </ImageView>
        <TextField fx:id="userInput" layoutY="558.0" onAction="#handleUserInput"
                   prefHeight="41.0" prefWidth="324.0"
                   AnchorPane.bottomAnchor="1.0" styleClass="command-input" />
        <Button fx:id="sendButton" layoutX="324.0" layoutY="558.0"
                mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="41.0" prefWidth="76.0" text="Launch" styleClass="launch-button" />
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" fitToWidth="true"
                    prefHeight="557.0" prefWidth="400.0" styleClass="space-scroll">
            <content>
                <VBox fx:id="dialogContainer" prefWidth="388.0" spacing="6.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
