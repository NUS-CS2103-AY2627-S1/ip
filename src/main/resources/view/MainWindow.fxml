<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="650.0" prefWidth="450.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jiji.gui.MainWindow">
  <children>
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                hvalue="1.0"
                pannable="true"
                prefHeight="584.0"
                prefWidth="450.0"
                vvalue="1.0"
                AnchorPane.bottomAnchor="58.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">
      <content>
        <VBox fx:id="dialogContainer"
              fillWidth="true"
              spacing="12.0" />
      </content>
    </ScrollPane>
    <TextField fx:id="userInput"
               onAction="#handleUserInput"
               prefHeight="42.0"
               promptText="Whisper a cozy task to Jiji (e.g. todo, deadline, stats)..."
               AnchorPane.bottomAnchor="8.0"
               AnchorPane.leftAnchor="8.0"
               AnchorPane.rightAnchor="88.0" />
    <Button fx:id="sendButton"
            mnemonicParsing="false"
            onAction="#handleUserInput"
            prefHeight="42.0"
            prefWidth="72.0"
            text="Send"
            AnchorPane.bottomAnchor="8.0"
            AnchorPane.rightAnchor="8.0" />
  </children>
</AnchorPane>
