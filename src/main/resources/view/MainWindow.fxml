<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane styleClass="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header">
            <padding>
                <Insets bottom="12" left="14" right="14" top="12" />
            </padding>
            <StackPane styleClass="nubish-avatar">
                <Circle radius="18" styleClass="avatar-circle" />
                <Label styleClass="avatar-label" text="N" />
            </StackPane>
            <Label styleClass="header-title" text="Nubish" />
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" styleClass="chat-scroll">
            <content>
                <VBox fx:id="chatBox" spacing="12" styleClass="chat-box">
                    <padding>
                        <Insets bottom="14" left="14" right="14" top="14" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10" styleClass="input-area">
            <padding>
                <Insets bottom="10" left="14" right="14" top="10" />
            </padding>
            <TextField fx:id="input" HBox.hgrow="ALWAYS" onAction="#handleUserInput"
                    promptText="Type a command" styleClass="message-input" />
            <Button fx:id="sendButton" onAction="#handleUserInput" styleClass="send-button" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
