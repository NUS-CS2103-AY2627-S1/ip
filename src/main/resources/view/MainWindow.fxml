<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    minWidth="400.0"
    minHeight="300.0"
    prefWidth="800.0"
    prefHeight="700.0"
    maxWidth="1.7976931348623157E308"
    maxHeight="1.7976931348623157E308"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="yapatron.MainWindow">

<children>
    <ImageView fx:id="backgroundImage"
        mouseTransparent="true"
        AnchorPane.bottomAnchor="0.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0"
        AnchorPane.topAnchor="0.0" 
        preserveRatio="false"
        pickOnBounds="true"/>

    <HBox fx:id="banner"
        alignment="CENTER_LEFT"
        prefHeight="150.0"
        minHeight="150.0"
        maxHeight="150.0"
        spacing="12.0"
        style="-fx-background-color: #B9DDF7;
        -fx-border-color: #1976D2;
        -fx-border-width: 3px;"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0"
        AnchorPane.topAnchor="0.0">

    <padding>
        <Insets bottom="8.0"
            left="18.0"
            right="18.0"
            top="8.0" />
    </padding>

    <children>

        <ImageView fx:id="bannerImage"
            fitHeight="130.0"
            fitWidth="150.0"
            preserveRatio="true" />

        <VBox alignment="CENTER_LEFT"
            minWidth="0.0"
            spacing="2.0"
            HBox.hgrow="ALWAYS">

        <children>
            <Label fx:id="bannerTitle"
                text="Yapatron"
                wrapText="true" />

            <Label fx:id="bannerSubtitle"
                text="ready for da yapyap #yapMINION"
                wrapText="true" />
        </children>

    </VBox>

</children>
        </HBox>
        <ScrollPane fx:id="scrollPane"
            fitToWidth="true"
            hbarPolicy="NEVER"
            AnchorPane.topAnchor="150.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.bottomAnchor="65.0"
            style="-fx-background-color: transparent;">

        <content>
            <VBox fx:id="dialogContainer"
                fillWidth="true"
                spacing="10.0" />
        </content>
    </ScrollPane>

    <TextField fx:id="userInput"
        onAction="#handleUserInput"
        promptText="type 'help' for commands"
        minHeight="65.0"
        prefHeight="65.0"
        maxHeight="65.0"
        AnchorPane.leftAnchor="0.0"
        AnchorPane.rightAnchor="0.0"
        AnchorPane.bottomAnchor="0.0" />

    <Button fx:id="sendButton"
        text="Send"
        onAction="#handleUserInput"
        prefHeight="65.0"
        prefWidth="100.0"
        AnchorPane.rightAnchor="0.0"
        AnchorPane.bottomAnchor="0.0" />
</children>
</AnchorPane>
