<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!--
  A column: the conversation takes whatever height is left over, and the input row
  sits under it. Laid out rather than anchored, so both grow with the window instead
  of leaving a gap when it is widened.
-->
<VBox prefHeight="620.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="tally.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0">
            <VBox.vgrow>
                <Priority fx:constant="ALWAYS" />
            </VBox.vgrow>
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0">
                    <padding>
                        <Insets bottom="14.0" left="12.0" right="12.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox styleClass="input-row" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Type a command, then press Enter">
                    <HBox.hgrow>
                        <Priority fx:constant="ALWAYS" />
                    </HBox.hgrow>
                </TextField>
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        minWidth="72.0" text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
