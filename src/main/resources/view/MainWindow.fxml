<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="620.0" prefWidth="440.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="fox.gui.MainWindow"
            stylesheets="@../css/main.css">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0"
                   promptText="Type a command..." AnchorPane.bottomAnchor="12.0"
                   AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="104.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="48.0" prefWidth="84.0" text="Send" AnchorPane.bottomAnchor="12.0"
                AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0"
                    vvalue="1.0" AnchorPane.bottomAnchor="72.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
