<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="640.0" prefWidth="460.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="harvey.ui.MainWindow">
    <children>
        <!-- A slim header that names who you are talking to, so the avatar beside each
             reply can stay small. Its height matches the scroll pane's top anchor. -->
        <HBox styleClass="header"
              alignment="CENTER_LEFT"
              spacing="10.0"
              prefHeight="52.0"
              minHeight="52.0"
              maxHeight="52.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <ImageView fitHeight="36.0" fitWidth="36.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/Harvey.png" />
                    </image>
                    <clip>
                        <Circle centerX="18.0" centerY="18.0" radius="18.0" />
                    </clip>
                </ImageView>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="header-name" text="Harvey Specter" />
                        <Label styleClass="header-tagline" text="The best closer in the city" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <!-- The two controls share one height and one bottom anchor, so they line up.
             The button also pins min and max height: without them its icon and border
             would push it taller than the field beside it. -->
        <TextField fx:id="userInput"
                   promptText="What's the case?"
                   onAction="#handleUserInput"
                   prefHeight="40.0"
                   minHeight="40.0"
                   maxHeight="40.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="84.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="40.0"
                minHeight="40.0"
                maxHeight="40.0"
                prefWidth="84.0"
                minWidth="84.0"
                text="File"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.rightAnchor="0.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    prefHeight="600.0"
                    prefWidth="460.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="40.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="52.0">
            <content>
                <VBox fx:id="dialogContainer"
                      prefHeight="595.0"
                      prefWidth="448.0" />
            </content>
        </ScrollPane>
    </children>
    <stylesheets>
        <URL value="@../css/main.css" />
    </stylesheets>
</AnchorPane>
