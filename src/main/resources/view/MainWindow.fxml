<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="480.0" stylesheets="@friday.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="friday.ui.MainWindow">
    <top>
        <VBox styleClass="header" spacing="3.0">
            <Label text="FRIDAY" styleClass="brand" />
            <Label text="Mission control for your tasks and contacts" styleClass="subtitle" wrapText="true" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" minWidth="0.0">
            <content>
                <VBox fx:id="dialogContainer" minWidth="0.0" spacing="12.0" styleClass="conversation" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox styleClass="composer" spacing="8.0">
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <TextField fx:id="userInput" onAction="#handleUserInput" minWidth="0.0"
                           promptText="Enter a command…" accessibleText="Command" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        text="Send" minWidth="68.0" />
            </HBox>
            <Label fx:id="inputHint" text="Try: todo read a book · list · help" styleClass="subtitle"
                   wrapText="true" />
        </VBox>
    </bottom>
</BorderPane>
