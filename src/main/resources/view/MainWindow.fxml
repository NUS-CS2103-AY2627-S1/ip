<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="640.0" minWidth="640.0"
            prefHeight="760.0" prefWidth="820.0"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sace.MainWindow">
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets bottom="22.0" left="30.0" right="30.0" top="24.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <Label styleClass="crest" text="&#10022;" />
                        <VBox spacing="1.0">
                            <children>
                                <Label styleClass="title" text="SACE" />
                                <Label styleClass="subtitle" text="YOUR MOONLIT STRATEGIST" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="statusLabel" styleClass="status-pill" text="&#9679;  ORACLE ONLINE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    hbarPolicy="NEVER" pannable="true"
                    styleClass="conversation-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="18.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="28.0" left="26.0" right="26.0" top="28.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="13.0" styleClass="composer-panel">
            <padding>
                <Insets bottom="22.0" left="26.0" right="26.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <Label styleClass="hint-label" text="COMMANDS" />
                        <Label styleClass="command-chip" text="help" />
                        <Label styleClass="command-chip" text="list" />
                        <Label styleClass="command-chip" text="todo" />
                        <Label styleClass="command-chip" text="deadline" />
                        <Label styleClass="command-chip" text="event" />
                        <Label styleClass="command-chip" text="find" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                                   onAction="#handleUserInput"
                                   promptText="Enter a command, e.g. todo prepare slides"
                                   styleClass="command-input" />
                        <Button fx:id="sendButton" defaultButton="true"
                                onAction="#handleUserInput"
                                styleClass="send-button" text="SEND  &#10095;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
