<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="680.0"
            prefWidth="460.0"
            fx:id="rootPane"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bob.gui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT"
              prefHeight="72.0"
              spacing="12.0"
              styleClass="app-header"
              AnchorPane.topAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <StackPane minHeight="46.0"
                           minWidth="46.0"
                           maxHeight="46.0"
                           maxWidth="46.0"
                           prefHeight="46.0"
                           prefWidth="46.0"
                           styleClass="header-avatar-frame">
                    <children>
                        <Circle radius="23.0" styleClass="header-avatar-ring" />
                        <ImageView fx:id="headerAvatar"
                                   fitHeight="42.0"
                                   fitWidth="42.0"
                                   preserveRatio="false" />
                    </children>
                </StackPane>

                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label fx:id="appTitle" styleClass="app-title" text="Bob" />
                                <Label fx:id="statusIndicator"
                                       accessibleText="Ready"
                                       contentDisplay="GRAPHIC_ONLY"
                                       styleClass="status-indicator">
                                    <graphic>
                                        <Circle radius="4.5" styleClass="status-dot" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip fx:id="statusTooltip" text="Ready" />
                                    </tooltip>
                                </Label>
                            </children>
                        </HBox>
                        <Label styleClass="app-subtitle" text="PERSONAL TASK ASSISTANT" />
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="helpButton"
                        accessibleText="Show command help"
                        minHeight="32.0"
                        onAction="#toggleHelpPanel"
                        prefHeight="32.0"
                        styleClass="header-help-button"
                        text="Commands">
                    <tooltip>
                        <Tooltip text="Command help" />
                    </tooltip>
                </Button>

            </children>
        </HBox>

        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.topAnchor="72.0"
                    AnchorPane.bottomAnchor="68.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="2.0" />
            </content>
        </ScrollPane>

        <VBox fx:id="helpPanel"
              managed="false"
              maxWidth="420.0"
              spacing="8.0"
              styleClass="help-panel"
              visible="false"
              AnchorPane.topAnchor="84.0"
              AnchorPane.bottomAnchor="76.0"
              AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="help-title" text="Command guide" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button accessibleText="Close command help"
                                onAction="#toggleHelpPanel"
                                styleClass="help-close-button"
                                text="×" />
                    </children>
                </HBox>

                <Label styleClass="help-introduction"
                       text="Use these commands in the message field below."
                       wrapText="true" />

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            styleClass="help-scroll-pane"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="5.0" styleClass="command-list">
                            <children>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="todo" />
                                    <Label styleClass="command-description"
                                           text="todo DESCRIPTION"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="deadline" />
                                    <Label styleClass="command-description"
                                           text="deadline DESCRIPTION /by DATE"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="event" />
                                    <Label styleClass="command-description"
                                           text="event DESCRIPTION /from DATE /to DATE"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="list" />
                                    <Label styleClass="command-description"
                                           text="Show every saved task"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="find" />
                                    <Label styleClass="command-description"
                                           text="find KEYWORD"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="search" />
                                    <Label styleClass="command-description"
                                           text="search PREFIX [PREFIX ...]"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="mark" />
                                    <Label styleClass="command-description"
                                           text="mark NUMBER"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="unmark" />
                                    <Label styleClass="command-description"
                                           text="unmark NUMBER"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="delete" />
                                    <Label styleClass="command-description"
                                           text="delete NUMBER"
                                           wrapText="true" />
                                </HBox>
                                <HBox alignment="TOP_LEFT" spacing="10.0" styleClass="command-row">
                                    <Label minWidth="72.0" styleClass="command-name" text="bye" />
                                    <Label styleClass="command-description"
                                           text="End the session"
                                           wrapText="true" />
                                </HBox>
                                <Label styleClass="help-date-note"
                                       text="DATE uses d/M/yyyy or d/M/yyyy HHmm, for example 2/12/2019 1800."
                                       wrapText="true" />
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <Label fx:id="inputFeedback"
               managed="false"
               styleClass="input-feedback"
               visible="false"
               wrapText="true"
               AnchorPane.bottomAnchor="62.0"
               AnchorPane.leftAnchor="18.0"
               AnchorPane.rightAnchor="18.0" />

        <HBox alignment="CENTER"
              styleClass="composer"
              AnchorPane.bottomAnchor="12.0"
              AnchorPane.leftAnchor="12.0"
              AnchorPane.rightAnchor="12.0">
            <children>
                <TextField fx:id="userInput"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           prefHeight="44.0"
                           promptText="Enter a command..." />

                <Button fx:id="sendButton"
                        minWidth="88.0"
                        onAction="#handleUserInput"
                        prefHeight="44.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
