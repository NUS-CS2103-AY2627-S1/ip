<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="crack.gui.MainWindow" prefWidth="460" prefHeight="620"
      stylesheets="@main.css">

  <HBox styleClass="app-header">
    <Label styleClass="app-name" text="Crack"/>
    <Label styleClass="app-tagline" text="keeps ts in check"/>
  </HBox>

  <ScrollPane fx:id="scrollPane" styleClass="chat-scroll" fitToWidth="true"
              hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
    <content>
      <VBox fx:id="dialogContainer" styleClass="dialog-container"/>
    </content>
  </ScrollPane>

  <HBox styleClass="input-bar">
    <TextField fx:id="userInput" styleClass="input-field" promptText="What we locking in, gng?"
               onAction="#handleUserInput" HBox.hgrow="ALWAYS"/>
    <Button fx:id="sendButton" styleClass="send-button" text="Send"
            onAction="#handleUserInput" defaultButton="true"/>
  </HBox>
</VBox>
