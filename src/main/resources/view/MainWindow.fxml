<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="760.0" prefWidth="720.0" styleClass="app-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="catgpt.MainWindow">
    <children>
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="app-header">
                    <children>
                        <Label alignment="CENTER" minHeight="52.0" minWidth="52.0"
                               styleClass="brand-mark" text="😹" />
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="app-title" text="CatGPT" />
                                <Label styleClass="app-subtitle"
                                       text="A paws-on task companion" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="storage-status" text="●  Saved locally" />
                    </children>
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                            styleClass="conversation-pane" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="dialogContainer" spacing="10.0"
                              styleClass="dialog-container" />
                    </content>
                </ScrollPane>
                <VBox spacing="10.0" styleClass="composer">
                    <children>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="userInput" onAction="#handleUserInput"
                                           promptText="Type a command, e.g. todo read a book"
                                           HBox.hgrow="ALWAYS" />
                                <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false"
                                        onAction="#handleUserInput" text="Send  →" />
                            </children>
                        </HBox>
                        <Label styleClass="command-hint"
                               text="Try  list  •  todo  •  deadline  •  event  •  find  •  sort" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
