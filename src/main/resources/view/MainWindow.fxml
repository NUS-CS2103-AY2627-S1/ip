<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="500.0" styleClass="main-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="rei.gui.MainWindow">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="72.0" prefHeight="72.0" styleClass="header">
                    <children>
                        <Label styleClass="title" text="REI" />
                        <Label styleClass="subtitle" text="  Your task companion" />
                    </children>
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0"
                              styleClass="conversation" />
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" minHeight="64.0" spacing="10.0" styleClass="composer">
                    <children>
                        <TextField fx:id="userInput" onAction="#handleUserInput"
                                   promptText="Type a command, e.g. todo read book"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false"
                                onAction="#handleUserInput" text="Send" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
