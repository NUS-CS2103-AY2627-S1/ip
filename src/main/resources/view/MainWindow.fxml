<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="420.0" minWidth="360.0"
            prefHeight="680.0" prefWidth="500.0"
            styleClass="main-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="notmarth.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="610.0"
                    prefWidth="500.0"
                    vbarPolicy="AS_NEEDED"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="76.0"
                    AnchorPane.leftAnchor="12.0"
                    AnchorPane.rightAnchor="12.0"
                    AnchorPane.topAnchor="12.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      prefWidth="476.0"
                      spacing="8.0" />
            </content>
        </ScrollPane>
        <HBox spacing="10.0"
              styleClass="input-bar"
              AnchorPane.bottomAnchor="12.0"
              AnchorPane.leftAnchor="12.0"
              AnchorPane.rightAnchor="12.0">
            <TextField fx:id="userInput"
                       onAction="#handleUserInput"
                       prefHeight="44.0"
                       promptText="Enter a mission order"
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton"
                    mnemonicParsing="false"
                    onAction="#handleUserInput"
                    prefHeight="44.0"
                    prefWidth="86.0"
                    text="Engage!" />
        </HBox>
    </children>
</AnchorPane>
