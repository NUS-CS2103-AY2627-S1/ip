<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="420.0" styleClass="main-window"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="meka.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" styleClass="dialog-scroll-pane" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="3.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox spacing="7.0" styleClass="input-bar">
            <padding>
                <Insets bottom="8.0" left="9.0" right="9.0" top="8.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Type a command..." HBox.hgrow="ALWAYS" />
                <Button defaultButton="true" mnemonicParsing="false" onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
