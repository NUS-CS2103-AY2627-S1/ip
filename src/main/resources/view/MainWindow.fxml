<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="520.0" styleClass="chat-root"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="crow.ui.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    hbarPolicy="NEVER" vbarPolicy="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" />
            </content>
        </ScrollPane>
    </center>
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="app-header">
            <children>
                <Label styleClass="app-title" text="Crow" />
            </children>
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
        </HBox>
    </top>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" styleClass="composer">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <TextField fx:id="userInputField" HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Message Crow" />
                <Button defaultButton="true" mnemonicParsing="false"
                        onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
