<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="520.0" styleClass="main-window"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="olaf.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Enter a command..." HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false"
                        onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
