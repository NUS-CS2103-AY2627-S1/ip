<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- A VBox root with a growing scroll pane, so the conversation takes all the
     space left over and the window can be resized freely. -->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="benjamin.gui.MainWindow"
      prefWidth="440.0"
      prefHeight="620.0"
      styleClass="app-root">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="chat-scroll"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" styleClass="chat-container" />
            </content>
        </ScrollPane>
        <HBox styleClass="input-bar" spacing="8.0">
            <children>
                <TextField fx:id="userInput"
                           promptText="something you would rather not forget"
                           onAction="#handleUserInput"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" />
            </children>
        </HBox>
    </children>
</VBox>
