<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0"
      prefWidth="400.0"
      fillWidth="true"
      spacing="8.0"
      styleClass="main-window"
      stylesheets="@../css/main.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="luckynoslacky.luckyui.gui.MainWindow">
    <padding>
        <Insets bottom="8.0" />
    </padding>
    <children>
        <VBox fx:id="brandHeaderSlot"
              id="brandHeaderSlot"
              styleClass="brand-header-slot">
            <children>
                <fx:include source="BrandHeader.fxml" />
            </children>
        </VBox>

        <ScrollPane fx:id="scrollPane"
                    id="scrollPane"
                    accessibleText="Here you see the whole chat history! Just use your arrow or page keys to scroll up scroll down can liao"
                    fitToWidth="true"
                    focusTraversable="true"
                    hbarPolicy="NEVER"
                    prefHeight="557.0"
                    prefWidth="400.0"
                    styleClass="conversation-region"
                    VBox.vgrow="ALWAYS">
            <content>
                <StackPane fx:id="personalityBackground"
                           id="personalityBackground"
                           styleClass="personality-background">
                    <children>
                        <Region mouseTransparent="true"
                                focusTraversable="false"
                                styleClass="personality-background-layer" />
                        <VBox fx:id="dialogContainer"
                              id="dialogContainer"
                              spacing="12.0"
                              fillWidth="true"
                              styleClass="dialog-container" />
                    </children>
                </StackPane>
            </content>
        </ScrollPane>

        <HBox id="commandRow"
              spacing="8.0"
              styleClass="command-row">
            <padding>
                <Insets left="8.0" right="8.0" />
            </padding>
            <children>
                <TextField fx:id="userInput"
                           accessibleText="Lai tell me what you want me to do, then click Send"
                           accessibleHelp="You can also press Enter to send the command without using the mouse."
                           id="userInput"
                           prefHeight="41.0"
                           promptText="Enter command..."
                           onAction="#handleUserInput"
                           HBox.hgrow="ALWAYS" />

                <Button fx:id="sendButton"
                        accessibleText="Send command"
                        accessibleHelp="Sends the command currently entered in the command field."
                        id="sendButton"
                        text="Send"
                        prefHeight="41.0"
                        prefWidth="70.0"
                        onAction="#handleUserInput" />
            </children>
        </HBox>
    </children>
</VBox>
