<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane prefHeight="680.0" prefWidth="520.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="seedu.goat.ui.MainWindow">
  <children>
    <HBox alignment="CENTER_LEFT" spacing="14.0" prefHeight="88.0" styleClass="brand-header"
          AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <StackPane minWidth="60.0" prefWidth="60.0" maxWidth="60.0"
                 minHeight="60.0" prefHeight="60.0" maxHeight="60.0" styleClass="brand-mark">
        <ImageView fitWidth="58.0" fitHeight="58.0" preserveRatio="true" smooth="true">
          <image><Image url="@../images/goat-mascot.png" /></image>
        </ImageView>
      </StackPane>
      <VBox alignment="CENTER_LEFT" spacing="3.0">
        <Label text="GOAT" styleClass="brand-title" />
        <Label text="Small steps. Big things." styleClass="brand-subtitle" />
      </VBox>
    </HBox>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                AnchorPane.topAnchor="88.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="100.0">
      <content>
        <VBox fx:id="dialogContainer" minHeight="-Infinity" styleClass="transcript" />
      </content>
    </ScrollPane>
    <VBox spacing="9.0" prefHeight="100.0" styleClass="composer"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="44.0"
                   minWidth="80.0" HBox.hgrow="ALWAYS" promptText="What's next? Try: todo read book" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                prefHeight="44.0" minWidth="70.0" />
      </HBox>
      <Label text="Your shortcuts:  list  /  find  /  on" styleClass="command-hint" />
    </VBox>
  </children>
</AnchorPane>
