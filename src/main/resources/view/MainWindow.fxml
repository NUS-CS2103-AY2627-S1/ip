<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" styleClass="main-window"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="am.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    prefHeight="545.0" prefWidth="400.0" vvalue="1.0"
                    AnchorPane.bottomAnchor="82.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="44.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" minWidth="0.0" prefWidth="388.0" />
            </content>
        </ScrollPane>
        <TextArea fx:id="userInput" prefHeight="68.0"
                   minWidth="0.0" prefRowCount="2" wrapText="true"
                   promptText="Enter a command..." AnchorPane.bottomAnchor="8.0"
                   AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="94.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="41.0" prefWidth="76.0" text="Send"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="12.0" />
        <Label fx:id="sessionEndHint" text="Session ended. You can close this window."
               styleClass="session-end-hint" managed="false" visible="false" wrapText="true"
               AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" />
        <Label mouseTransparent="true" text="AM" styleClass="window-title"
               AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="8.0" />
    </children>
</AnchorPane>
