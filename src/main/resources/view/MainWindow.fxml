<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="600.0" styleClass="app-shell"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="janet.ui.MainWindow">
    <top>
        <VBox spacing="7.0" styleClass="header">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="eyebrow" text="YOUR PERSONAL TASK ASSISTANT" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="title" text="Janet" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="status-pill" text="NOT A ROBOT" />
                    </children>
                </HBox>
                <Label styleClass="subtitle" text="Warm, wonderfully organized, and ready to help" />
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" styleClass="conversation">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0">
                    <padding>
                        <Insets bottom="22.0" left="18.0" right="18.0" top="22.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="12.0" styleClass="composer">
            <padding>
                <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput" promptText="Ask Janet to organize something..." />
                <Button fx:id="sendButton" defaultButton="true"
                        onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
