<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600.0" minWidth="400.0" prefHeight="600.0" prefWidth="400.0"
            styleClass="main-window" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="nova.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true"
                    AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Enter a command..." AnchorPane.bottomAnchor="8.0"
                   AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="84.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                prefWidth="68.0" text="Send" AnchorPane.bottomAnchor="8.0"
                AnchorPane.rightAnchor="8.0" />
    </children>
</AnchorPane>
