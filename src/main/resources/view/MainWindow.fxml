<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0" prefWidth="720.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pavanmaxxer.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.bottomAnchor="56.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="4.0">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0"
                                top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   prefHeight="44.0" promptText="Enter a command..."
                   AnchorPane.bottomAnchor="6.0" AnchorPane.leftAnchor="8.0"
                   AnchorPane.rightAnchor="108.0" />
        <Button mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="44.0" prefWidth="92.0" text="Send"
                AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="8.0" />
    </children>
</AnchorPane>
