<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bubba.MainWindow"
      prefHeight="600.0" prefWidth="420.0"
      spacing="10.0" stylesheets="@../css/main.css"
      styleClass="main-window">
    <ScrollPane fx:id="scrollPane" fitToWidth="true"
                hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="dialogContainer" spacing="4.0" />
        </content>
    </ScrollPane>
    <HBox spacing="8.0">
        <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                   onAction="#handleUserInput"
                   promptText="Enter a command..." />
        <Button fx:id="sendButton" defaultButton="true"
                onAction="#handleUserInput" text="Send" />
    </HBox>
</VBox>
