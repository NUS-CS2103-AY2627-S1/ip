<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="560.0" styleClass="app-root"
            stylesheets="@gatsby.css" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="gatsby.ui.MainWindow">
    <top>
        <VBox styleClass="header" spacing="4.0">
            <children>
                <Label styleClass="title" text="Gatsby" />
                <Label styleClass="subtitle" text="Your friendly task companion" />
            </children>
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="20.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="conversation-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox styleClass="composer" spacing="10.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Try: todo read book" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        styleClass="send-button" text="Send" />
            </children>
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="14.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
