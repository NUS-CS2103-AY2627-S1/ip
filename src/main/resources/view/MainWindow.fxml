<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="360.0"
            minWidth="320.0"
            prefHeight="620.0"
            prefWidth="440.0"
            styleClass="app-shell"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lumi.ui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="9.0" styleClass="app-header">
            <children>
                <Label alignment="CENTER"
                       minHeight="32.0"
                       minWidth="32.0"
                       styleClass="header-mark"
                       text="L" />
                <VBox>
                    <children>
                        <Label styleClass="app-title" text="Lumi" />
                        <Label styleClass="app-subtitle" text="Your calm task navigator" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="2.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="8.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER"
              spacing="8.0"
              styleClass="composer">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command…">
                    <HBox.hgrow>
                        <Priority fx:constant="ALWAYS" />
                    </HBox.hgrow>
                </TextField>
                <Button fx:id="sendButton"
                        defaultButton="true"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
