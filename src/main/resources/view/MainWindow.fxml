<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="520.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="toot.ui.MainWindow">
    <top>
        <VBox styleClass="header">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>
            <children>
                <Label styleClass="title" text="Toot" />
                <Label styleClass="subtitle" text="ur teeny-tiny task buddy" />
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="14.0">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10.0" styleClass="input-bar">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo read book" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
