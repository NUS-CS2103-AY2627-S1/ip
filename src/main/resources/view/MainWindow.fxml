<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="520.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tasque.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    minWidth="0.0"
                    pannable="true"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="64.0"
                    AnchorPane.leftAnchor="12.0"
                    AnchorPane.rightAnchor="12.0"
                    AnchorPane.topAnchor="12.0">
            <content>
                <VBox fx:id="dialogContainer"
                      alignment="TOP_CENTER"
                      fillWidth="true"
                      minWidth="0.0"
                      spacing="10.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="40.0"
                   promptText="Enter a command..."
                   AnchorPane.bottomAnchor="12.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="112.0" />
        <Button fx:id="sendButton"
                defaultButton="true"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="40.0"
                prefWidth="88.0"
                text="Send"
                AnchorPane.bottomAnchor="12.0"
                AnchorPane.rightAnchor="12.0" />
    </children>
</AnchorPane>
