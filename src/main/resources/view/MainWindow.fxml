<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tangent.gui.MainWindow">
    <children>
        <VBox prefHeight="29.0" prefWidth="315.0" spacing="2" styleClass="header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label styleClass="header-title" text="Tangent">
                     <font>
                        <Font name="Google Sans SemiBold" size="19.0" />
                     </font></Label>
                        <Region HBox.hgrow="ALWAYS" />
                      <Label styleClass="header-subtitle" text="your chill and friendly chatbot">
                     <font>
                        <Font name="Comic Sans MS" size="12.0" />
                     </font>
                  </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" layoutY="51.333333333333336" prefHeight="124.0" prefWidth="315.0" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="78.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="51.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" styleClass="transcript" />
            </content>
        </ScrollPane>
        <VBox minHeight="78.0" prefHeight="78.0" prefWidth="315.0" spacing="9" styleClass="input-bar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="10">
                    <children>
                        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="40.0" promptText="Type a command..." HBox.hgrow="ALWAYS">
                       <font>
                          <Font name="Google Sans 17pt Regular" size="12.0" />
                       </font></TextField>
                        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="40.0" text="Send  →">
                       <font>
                          <Font name="Google Sans Medium" size="12.0" />
                       </font></Button>
                    </children>
                </HBox>
                <Label styleClass="command-hint" text="commands: todo / deadline / event / mark / unmark / delete / list / find" />
            </children>
            <padding>
                <Insets bottom="3.0" left="16.0" right="16.0" top="8.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
