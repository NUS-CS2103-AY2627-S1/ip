<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="680.0" prefWidth="540.0" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="slotbot.gui.MainWindow">
    <top>
        <VBox spacing="6" styleClass="header">
            <Label text="SlotBot" styleClass="title"/>
            <Label text="A little order for your day" styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox fx:id="dialogContainer" spacing="16" styleClass="conversation"/>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="10" styleClass="composer">
            <Label text="todo · deadline · event · list · find · mark · unmark · delete · bye"
                   wrapText="true" styleClass="hint"/>
            <HBox spacing="10">
                <TextField fx:id="userInput" promptText="Type a command…" accessibleText="Command"
                           onAction="#handleUserInput" HBox.hgrow="ALWAYS" styleClass="command-input"/>
                <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" minWidth="76"
                        styleClass="send-button"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
