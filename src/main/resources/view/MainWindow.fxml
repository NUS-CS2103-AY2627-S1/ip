<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- Only a preferred size is given, so the window starts at this size but the user can
     resize it freely; every child below is anchored to the edges and follows along. -->
<AnchorPane prefHeight="620.0" prefWidth="440.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="davidgoggins.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" vbarPolicy="AS_NEEDED"
                    vvalue="1.0" fitToWidth="true" AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="57.0">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>

        <!-- The input row is an HBox so the text field can absorb every spare pixel
             of width, which an AnchorPane alone cannot express as cleanly. -->
        <HBox styleClass="input-bar" alignment="CENTER" prefHeight="57.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="41.0"
                           promptText="What are you gonna do about it? (try: help)">
                    <HBox.hgrow>ALWAYS</HBox.hgrow>
                </TextField>
                <Button fx:id="sendButton" styleClass="send-button" mnemonicParsing="false"
                        onAction="#handleUserInput" prefHeight="41.0" prefWidth="110.0"
                        text="STAY HARD" />
            </children>
        </HBox>
    </children>
</AnchorPane>
