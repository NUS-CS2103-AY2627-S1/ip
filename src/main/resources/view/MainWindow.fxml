<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="400.0"
            prefHeight="600.0" prefWidth="400.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="anby.MainWindow">
  <children>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="0.0"
                prefHeight="557.0" prefWidth="400.0" vbarPolicy="ALWAYS"
                AnchorPane.bottomAnchor="43.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <content>
        <VBox fx:id="dialogContainer" prefWidth="388.0" />
      </content>
    </ScrollPane>
    <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="43.0"
               promptText="Ask Anby..." AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="64.0" />
    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
            prefHeight="43.0" prefWidth="64.0" text="Send"
            AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" />
  </children>
</AnchorPane>
