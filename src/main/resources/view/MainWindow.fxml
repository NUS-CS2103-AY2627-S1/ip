<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainLayout"
            prefHeight="720.0" prefWidth="680.0"
            styleClass="main-window"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="larp.MainWindow">
    <top>
        <VBox spacing="4.0" styleClass="app-header">
            <padding>
                <Insets bottom="18.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <Label styleClass="app-title" text="Larp" />
            <Label styleClass="app-subtitle" text="A quiet place for the tasks on your mind" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="conversation-scroll">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="14.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="24.0" left="20.0" right="20.0" top="24.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="8.0" styleClass="composer">
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="14.0" />
            </padding>
            <Label styleClass="command-hint"
                   text="Try: todo read a book  •  list  •  find book" />
            <HBox spacing="10.0">
                <TextField fx:id="userInput"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Enter a command" />
                <Button fx:id="sendButton"
                        defaultButton="true"
                        onAction="#handleUserInput"
                        text="Send" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
