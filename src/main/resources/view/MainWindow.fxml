<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:controller="sage.MainWindow" prefHeight="420.0" prefWidth="560.0"
            stylesheets="" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ScrollPane fx:id="messageScroll" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="48.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="conversation" spacing="8.0" />
            </content>
        </ScrollPane>
        <HBox spacing="6.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="input" onAction="#send" promptText="Type a command..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" onAction="#send" text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
