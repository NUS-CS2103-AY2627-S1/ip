<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="440.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="snoopy.gui.MainWindow">
    <children>
        <Label alignment="CENTER_LEFT"
               prefHeight="44.0"
               styleClass="app-title"
               text="Snoopy"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="557.0"
                    prefWidth="440.0"
                    AnchorPane.bottomAnchor="54.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="44.0">
            <content>
                <VBox fx:id="dialogContainer"
                      prefHeight="500.0"
                      prefWidth="428.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="44.0"
                   promptText="Type a command..."
                   AnchorPane.bottomAnchor="5.0"
                   AnchorPane.leftAnchor="6.0"
                   AnchorPane.rightAnchor="92.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="44.0"
                prefWidth="80.0"
                text="Send"
                AnchorPane.bottomAnchor="5.0"
                AnchorPane.rightAnchor="6.0" />
    </children>
</AnchorPane>
