<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="420.0" minWidth="320.0"
    prefHeight="600.0" prefWidth="400.0"
    stylesheets="@styles.css"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="littler.gui.MainWindow">
    <children>
        <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="chat-scroll-pane"
                    VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="dialogContainer" styleClass="dialog-container" />
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar">
                    <children>
                        <TextField fx:id="userInput"
                            onAction="#handleUserInput"
                            promptText="Type a command... (try 'help')"
                            styleClass="chat-input"
                            HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton"
                            mnemonicParsing="false"
                            onAction="#handleUserInput"
                            styleClass="send-button"
                            text="Send" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
