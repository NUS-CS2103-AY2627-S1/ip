<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minWidth="0.0" prefHeight="720.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="serina.gui.MainWindow">
    <top>
        <StackPane fx:id="appHeader" maxHeight="68.0" minHeight="68.0" minWidth="0.0"
                   prefHeight="68.0" styleClass="app-header">
            <children>
                <!-- Artwork follows the header size without contributing its previous width to layout. -->
                <ImageView fx:id="headerBackground" managed="false" mouseTransparent="true" preserveRatio="false"
                           smooth="true" styleClass="header-background" />
                <Region maxHeight="1.7976931348623157E308"
                        maxWidth="1.7976931348623157E308" styleClass="header-overlay" />
                <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="10.0" styleClass="header-content">
                    <padding>
                        <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
                    </padding>
                    <StackPane fx:id="serinaPortraitFrame" maxHeight="46.0" maxWidth="46.0"
                               minHeight="46.0" minWidth="46.0" prefHeight="46.0" prefWidth="46.0"
                               styleClass="serina-portrait-frame">
                        <children>
                            <ImageView fx:id="serinaPortrait" fitHeight="40.0" fitWidth="40.0"
                                       preserveRatio="true" smooth="true" />
                        </children>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="0.0"
                          spacing="1.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label styleClass="brand-label" text="SERINA" />
                            <Label fx:id="headerSubtitle" styleClass="header-subtitle"
                                   text="SPIRIT OF FIRE · COMMAND INTERFACE" />
                        </children>
                    </VBox>
                    <HBox fx:id="captainIdentity" alignment="CENTER_LEFT" spacing="6.0"
                          styleClass="captain-identity">
                        <children>
                            <ImageView fx:id="cutterPortrait" fitHeight="24.0" fitWidth="24.0"
                                       preserveRatio="true" smooth="true" />
                            <Label styleClass="captain-label" text="CAPTAIN CUTTER" />
                        </children>
                    </HBox>
                    <Button fx:id="helpButton" minWidth="-Infinity" onAction="#handleHelp" styleClass="help-button"
                            text="HELP" />
                </HBox>
            </children>
        </StackPane>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" minWidth="0.0"
                    pannable="true" styleClass="chat-scroll" vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="6.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
            <BorderPane.margin>
                <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
            </BorderPane.margin>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0" styleClass="composer">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>
            <TextField fx:id="userInput" maxWidth="1.7976931348623157E308" minWidth="0.0"
                       onAction="#handleUserInput" promptText="Enter a command…"
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" minWidth="84.0" onAction="#handleUserInput"
                    styleClass="send-button" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
