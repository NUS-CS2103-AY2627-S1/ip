<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            styleClass="main-window"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="aster.gui.MainWindow">
    <children>
        <BorderPane styleClass="app-shell"
                    AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
            <top>
                <HBox styleClass="app-header" alignment="CENTER">
                    <children>
                        <HBox styleClass="header-content" alignment="CENTER_LEFT"
                              maxWidth="680.0" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fx:id="headerMark" fitWidth="28.0" fitHeight="28.0"
                                           preserveRatio="true" smooth="true"
                                           accessibleText="Aster logo">
                                    <image>
                                        <Image url="@../images/aster.png" />
                                    </image>
                                </ImageView>
                                <VBox styleClass="header-text" alignment="CENTER_LEFT" minWidth="0.0">
                                    <children>
                                        <Label styleClass="header-title" text="Aster" />
                                        <Label styleClass="header-subtitle"
                                               text="Plan tasks. Stay on track."
                                               minWidth="0.0" textOverrun="ELLIPSIS" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </top>
            <center>
                <ScrollPane fx:id="scrollPane" styleClass="conversation-scroll"
                            fitToWidth="true" hbarPolicy="NEVER">
                    <content>
                        <StackPane fx:id="conversationColumn" styleClass="conversation"
                                   alignment="TOP_CENTER">
                            <children>
                                <VBox fx:id="dialogContainer" styleClass="dialog-container"
                                      maxWidth="680.0" />
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <HBox styleClass="composer" alignment="CENTER">
                    <children>
                        <HBox styleClass="composer-content" alignment="CENTER"
                              maxWidth="680.0" HBox.hgrow="ALWAYS">
                            <children>
                                <TextField fx:id="userInput" styleClass="composer-field"
                                           HBox.hgrow="ALWAYS" onAction="#handleUserInput"
                                           promptText="Type a command, then press Enter"
                                           accessibleText="Command" />
                                <Button fx:id="sendButton" styleClass="send-button" text="Send"
                                        mnemonicParsing="false" onAction="#handleUserInput"
                                        minWidth="-Infinity" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
