<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
            minHeight="420.0" minWidth="320.0"
            prefHeight="600.0" prefWidth="420.0"
            stylesheets="@styles.css"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="carl.ui.MainWindow">
    <children>
        <!-- Top Accent Banner -->
        <HBox alignment="CENTER_LEFT"
              prefHeight="50.0"
              styleClass="app-header"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="16.0" right="16.0" />
            </padding>
            <children>
                <Circle radius="4.0" styleClass="status-indicator" />
                <Label styleClass="header-title" text="Carl · Night-Shift Dispatcher" />
            </children>
        </HBox>

        <!-- Chat Area with Telegram Pattern Background -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.topAnchor="50.0"
                    AnchorPane.bottomAnchor="58.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    styleClass="chat-scroll">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="6.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="10.0" left="8.0" right="8.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <!-- Input Bar -->
        <HBox alignment="CENTER"
              spacing="8.0"
              prefHeight="58.0"
              styleClass="input-bar"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
            <children>
                <TextField fx:id="userInput"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Write a message..."
                           styleClass="message-input" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="36.0"
                        prefWidth="58.0"
                        minWidth="58.0"
                        styleClass="send-button"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
