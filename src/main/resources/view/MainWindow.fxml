<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="520.0" styleClass="app-root"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gary.gui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header">
            <padding>
                <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
            </padding>
            <children>
                <StackPane maxHeight="38.0" maxWidth="38.0"
                           minHeight="38.0" minWidth="38.0" styleClass="brand-icon">
                    <children>
                        <ImageView fitHeight="35.0" fitWidth="35.0"
                                   preserveRatio="true" smooth="true">
                            <image>
                                <Image url="@../images/gary-profile.png" />
                            </image>
                        </ImageView>
                    </children>
                </StackPane>
                <VBox spacing="1.0">
                    <children>
                        <Label styleClass="title" text="GARY" />
                        <Label styleClass="subtitle"
                               text="Your sea-snail task companion" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="conversation-background">
            <children>
                <Region maxHeight="1.7976931348623157E308"
                        maxWidth="1.7976931348623157E308"
                        mouseTransparent="true" styleClass="background-tint" />
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                            pannable="true" styleClass="conversation-pane">
                    <content>
                        <VBox fx:id="dialogContainer" fillWidth="true" spacing="9.0"
                              styleClass="dialog-container">
                            <padding>
                                <Insets bottom="14.0" left="12.0" right="12.0" top="14.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </StackPane>
    </center>
    <bottom>
        <HBox fx:id="inputBar" spacing="10.0" styleClass="input-bar">
            <padding>
                <Insets bottom="11.0" left="12.0" right="12.0" top="11.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo read book"
                           styleClass="command-field" />
                <Button fx:id="sendButton" onAction="#handleUserInput"
                        styleClass="send-button"
                        text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
