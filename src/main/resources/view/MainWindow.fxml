<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="220" minWidth="400" prefHeight="600"
            prefWidth="420" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="chud.gui.MainWindow" stylesheets="@DarkTheme.css">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="12.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
            </padding>
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" promptText="yap here 🗣️"
                           styleClass="text-input" HBox.hgrow="ALWAYS"/>
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        styleClass="send-button" text="Lock In"/>
            </children>
        </HBox>
    </children>
</AnchorPane>
