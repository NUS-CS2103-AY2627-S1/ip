<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The main window: a scrolling conversation on top, an input field and a
  Send button pinned along the bottom. Both the button and the Enter key on
  the text field call the controller's #handleUserInput method.
-->
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="altair.gui.MainWindow"
            id="root-pane"
            minHeight="600.0" minWidth="400.0"
            prefHeight="600.0" prefWidth="400.0">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="40.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="6.0" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   promptText="Type a command and press Enter"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="76.0"
                   AnchorPane.bottomAnchor="0.0"
                   prefHeight="40.0" />
        <Button fx:id="sendButton"
                text="Send"
                onAction="#handleUserInput"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                prefWidth="76.0" prefHeight="40.0" />
    </children>
</AnchorPane>
