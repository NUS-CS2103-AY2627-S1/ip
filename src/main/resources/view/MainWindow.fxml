<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="440.0" minWidth="360.0" prefHeight="640.0" prefWidth="430.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unicorn.ui.MainWindow">
    <children>
        <Label fx:id="brandLabel" alignment="CENTER" text="PRISMA  ✦  QUEST CONSOLE" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0" promptText="Enter your next quest..." AnchorPane.bottomAnchor="6.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="102.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="48.0" prefWidth="88.0" text="SEND ✦" AnchorPane.bottomAnchor="6.0" AnchorPane.rightAnchor="8.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="52.0">
            <content>
                <VBox fx:id="dialogContainer" alignment="TOP_LEFT" fillWidth="true" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
