<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  A VBox root rather than an AnchorPane: the conversation takes all the leftover height
  and the input row keeps its own, so the window resizes without any hard-coded anchors.
-->
<VBox prefHeight="640.0" prefWidth="480.0" stylesheets="@../css/main.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="quu.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo read book" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        text="Send" />
            </children>
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="4.0" />
            </padding>
        </HBox>
    </children>
</VBox>
