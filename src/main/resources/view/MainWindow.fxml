<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="260.0" minWidth="417.0"
            prefHeight="600.0" prefWidth="400.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="leo.MainWindow">
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll-pane"
                AnchorPane.bottomAnchor="90.0" AnchorPane.leftAnchor="1.0"
                AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
        <VBox fx:id="dialogContainer" prefWidth="400.0" spacing="10.0" styleClass="dialog-container">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </VBox>
    </ScrollPane>

    <!--
      A-BetterGui: quick-action buttons for the commands a new user is
      least likely to remember the exact syntax for. "List" and "Bye"
      need no further input, so clicking them sends the command
      immediately (see MainWindow#submitCommand); "Todo"/"Deadline"/
      "Event" need the user's own details, so clicking them instead
      fills the text field with a ready-to-edit template and focuses
      it (see MainWindow#prefillCommand) rather than guessing at
      arguments on the user's behalf.
    -->
    <HBox alignment="CENTER_LEFT" prefHeight="32.0" spacing="6.0"
          AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0">
        <Button fx:id="listButton" mnemonicParsing="false" onAction="#handleListButton"
                styleClass="quick-action-button" text="📋 List"/>
        <Button fx:id="todoButton" mnemonicParsing="false" onAction="#handleTodoButton"
                styleClass="quick-action-button" text="📝 Todo"/>
        <Button fx:id="deadlineButton" mnemonicParsing="false" onAction="#handleDeadlineButton"
                styleClass="quick-action-button" text="⏰ Deadline"/>
        <Button fx:id="eventButton" mnemonicParsing="false" onAction="#handleEventButton"
                styleClass="quick-action-button" text="📅 Event"/>
        <Button fx:id="byeButton" mnemonicParsing="false" onAction="#handleByeButton"
                styleClass="quick-action-button" text="👋 Bye"/>
    </HBox>

    <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command, e.g. list"
               prefHeight="41.0" styleClass="command-input"
               AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"
               AnchorPane.rightAnchor="86.4"/>

    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
            prefHeight="41.0" prefWidth="87.4" styleClass="send-button" text="Send"
            AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0"/>
</AnchorPane>
