<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alice.ui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT"
              spacing="12.0"
              styleClass="header"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Label styleClass="header-avatar" text="◇" />
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="header-title" text="ALICE" />
                        <Label styleClass="header-subtitle" text="Your thoughtful task companion" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="58.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="76.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10.0" />
            </content>
        </ScrollPane>
        <HBox spacing="8.0"
              styleClass="input-area"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command..."
                           HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
