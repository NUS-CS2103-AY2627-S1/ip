<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
            minHeight="560.0" minWidth="440.0"
            prefHeight="720.0" prefWidth="520.0"
            style="-fx-background-color: #f5f7fb;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="waffles.MainWindow">
    <children>
        <VBox spacing="2.0"
              style="-fx-background-color: #243b53; -fx-padding: 14 18 13 18;"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Label text="Waffles"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
                <Label text="Your upbeat planning co-pilot for getting things done"
                       style="-fx-text-fill: #d9e2ec; -fx-font-size: 12px;" />
            </children>
        </VBox>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="41.0"
                   promptText="Type a Waffles command"
                   style="-fx-background-color: white; -fx-border-color: #bcccdc; -fx-border-radius: 8;"
                   AnchorPane.bottomAnchor="8.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="104.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="41.0"
                text="Send  ➤"
                style="-fx-background-color: #f0b429; -fx-text-fill: #243b53; -fx-font-weight: bold; -fx-background-radius: 8;"
                AnchorPane.bottomAnchor="8.0"
                AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="57.0"
                    AnchorPane.leftAnchor="8.0"
                    AnchorPane.rightAnchor="8.0"
                    AnchorPane.topAnchor="62.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="10.0"
                      style="-fx-padding: 12 6 12 6;" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
