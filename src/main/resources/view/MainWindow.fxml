<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640.0" prefWidth="720.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="yqr.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="chat-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="6.0"
                      styleClass="dialog-container">
                    <padding>
                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER" spacing="8.0" styleClass="composer">
            <padding>
                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Enter a command (e.g. todo read a book)"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" defaultButton="true"
                        onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </children>
</VBox>
