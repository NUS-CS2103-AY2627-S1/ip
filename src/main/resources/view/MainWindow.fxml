<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="640.0" prefWidth="520.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="eden.gui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              styleClass="app-header"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <children>
                        <Label styleClass="app-title" text="Eden" />
                        <Label styleClass="app-subtitle"
                               text="A calm place for everything you need to do" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="12.0" left="18.0" right="18.0" top="12.0" />
            </padding>
        </HBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    hbarPolicy="NEVER" vvalue="1.0"
                    AnchorPane.bottomAnchor="62.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="68.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true"
                      minHeight="0.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   prefHeight="40.0" promptText="Type a command..."
                   styleClass="command-input"
                   AnchorPane.bottomAnchor="11.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="104.0" />
        <Button defaultButton="true" mnemonicParsing="false"
                onAction="#handleUserInput" prefHeight="40.0"
                prefWidth="84.0" styleClass="send-button" text="Send"
                AnchorPane.bottomAnchor="11.0"
                AnchorPane.rightAnchor="12.0" />
    </children>
</AnchorPane>
