<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane minHeight="360.0" minWidth="320.0" prefHeight="640.0" prefWidth="480.0" stylesheets="@record.css" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="recordbase.ui.MainWindowController">
  <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="app-header">
      <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0" /></padding>
      <VBox spacing="2.0"><Label styleClass="app-title" text="RECORD" /><Label styleClass="app-subtitle" text="KEEP LIFE ON TRACK" /></VBox>
      <Region HBox.hgrow="ALWAYS" /><Label styleClass="avatar-label" text="My avatar" />
      <ChoiceBox fx:id="avatarChoice" onAction="#handleAvatarChoice" prefWidth="112.0" />
    </HBox>
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="conversation-scroll" VBox.vgrow="ALWAYS">
      <content><VBox fx:id="dialogContainer" fillWidth="true" spacing="4.0" styleClass="dialog-container"><padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding></VBox></content>
    </ScrollPane>
    <HBox alignment="CENTER" spacing="8.0" styleClass="composer">
      <padding><Insets bottom="12.0" left="12.0" right="12.0" top="10.0" /></padding>
      <Button fx:id="listItemsBtn" minWidth="64.0" mnemonicParsing="false" onAction="#handleButtonListItems" styleClass="secondary-button" text="List" />
      <TextField fx:id="userInput" onAction="#handleSendUserInput" onKeyPressed="#handleUpDownKeyPress" promptText="What shall we put on the record?" HBox.hgrow="ALWAYS" />
      <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSendUserInput" styleClass="send-button" text="Send" />
    </HBox>
  </VBox>
</AnchorPane>
