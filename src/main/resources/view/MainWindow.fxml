<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="420.0" minWidth="420.0" prefHeight="640.0" prefWidth="720.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jason.gui.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="app-header">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="app-title" text="Jason" />
                        <Label styleClass="app-subtitle" text="Your structured task companion" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="app-status" text="JSON MODE" />
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="conversation-pane" vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="6.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="14.0" left="10.0" right="10.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" styleClass="input-bar">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
