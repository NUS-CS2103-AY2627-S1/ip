<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="440.0"
            stylesheets="@sozius.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sozius.ui.MainWindow">
    <children>
        <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <top>
                <VBox spacing="3.0" styleClass="header">
                    <Label text="Sozius" styleClass="app-title" />
                    <Label text="Your tasks, one command at a time." styleClass="subtitle" />
                </VBox>
            </top>
            <center>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" minWidth="0.0"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="conversation">
                    <content>
                        <VBox fx:id="dialogContainer" spacing="12.0" minWidth="0.0"
                              fillWidth="true" styleClass="dialog-container" />
                    </content>
                </ScrollPane>
            </center>
            <bottom>
                <VBox spacing="6.0" styleClass="composer">
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <TextField fx:id="userInput" minWidth="0.0" HBox.hgrow="ALWAYS"
                                   promptText="Type a command…" accessibleText="Command"
                                   onAction="#handleUserInput" />
                        <Button fx:id="sendButton" text="Send" minWidth="64.0"
                                mnemonicParsing="false" onAction="#handleUserInput" />
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
