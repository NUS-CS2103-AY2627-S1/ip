<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="1.7976931348623157E308"
            maxWidth="1.7976931348623157E308"
            minHeight="450.0" minWidth="360.0"
            prefHeight="600.0" prefWidth="400.0"
            styleClass="main-window"
            stylesheets="@caesar.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="caesar.gui.MainWindow">
    <children>
        <VBox spacing="2.0"
              styleClass="header"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Label styleClass="app-title" text="Caesar" />
                <Label styleClass="app-subtitle" text="Your gentle task companion" />
            </children>
        </VBox>
        <TextField fx:id="userInput"
                   layoutY="558.0"
                   onAction="#handleUserInput"
                   prefHeight="41.0"
                   prefWidth="324.0"
                   promptText="Enter a command"
                   styleClass="command-input"
                   AnchorPane.bottomAnchor="1.0"
                   AnchorPane.leftAnchor="1.0"
                   AnchorPane.rightAnchor="76.0" />
        <Button fx:id="sendButton"
                layoutX="324.0"
                layoutY="558.0"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="41.0"
                prefWidth="76.0"
                text="Send"
                styleClass="send-button"
                AnchorPane.bottomAnchor="1.0"
                AnchorPane.rightAnchor="1.0" />
        <Button fx:id="helpButton"
                mnemonicParsing="false"
                onAction="#handleHelp"
                prefHeight="30.0"
                prefWidth="64.0"
                text="HELP"
                styleClass="help-button"
                AnchorPane.rightAnchor="14.0"
                AnchorPane.topAnchor="12.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="557.0"
                    prefWidth="400.0"
                    styleClass="conversation-scroll"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="42.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="62.0">
            <content>
                <VBox fx:id="dialogContainer"
                      styleClass="dialog-container"
                      spacing="14.0" />
            </content>
        </ScrollPane>
        <Label fx:id="commandPreview"
               managed="false"
               visible="false"
               styleClass="command-preview"
               AnchorPane.bottomAnchor="45.0"
               AnchorPane.leftAnchor="14.0" />
    </children>
</AnchorPane>
