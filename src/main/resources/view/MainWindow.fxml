<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.MainWindow"
            minWidth="400" minHeight="500"
            prefWidth="480" prefHeight="640"
            stylesheets="@styles.css">

    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="60"
                styleClass="chat-scroll">
        <VBox fx:id="dialogContainer" spacing="10" styleClass="dialog-container">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
        </VBox>
    </ScrollPane>

    <HBox spacing="8"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
          styleClass="input-bar">
        <padding>
            <Insets top="10" right="12" bottom="10" left="12"/>
        </padding>
        <TextField fx:id="userInput" promptText="Type a message..."
                   onAction="#handleUserInput" HBox.hgrow="ALWAYS" styleClass="user-input"/>
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" styleClass="send-button"/>
    </HBox>

</AnchorPane>
