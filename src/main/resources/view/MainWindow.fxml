<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="500.0" stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="happybot.MainWindow">
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="58.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox fx:id="dialogContainer" spacing="14.0" styleClass="dialog-container" />
        </content>
    </ScrollPane>
    <TextField fx:id="userInput" onAction="#handleUserInput"
               promptText="Type a command..." styleClass="command-input"
               AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="12.0"
               AnchorPane.rightAnchor="92.0" />
    <Button fx:id="sendButton" defaultButton="true" onAction="#handleUserInput" text="Send"
            AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="12.0" />
</AnchorPane>
