<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:controller="lobby.gui.MainWindow"
            prefHeight="680.0" prefWidth="480.0"
            stylesheets="@/css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox styleClass="app-shell"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="header">
                    <children>
                        <Label styleClass="title" text="Lobby" />
                    </children>
                </HBox>
                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                            pannable="true" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="dialogContainer" fillWidth="true" spacing="8.0"
                              styleClass="dialog-container" />
                    </content>
                </ScrollPane>
                <HBox spacing="10.0" styleClass="composer">
                    <children>
                        <TextField fx:id="userInput" onAction="#handleUserInput"
                                   promptText="Type a command, e.g. list" HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton" defaultButton="true"
                                onAction="#handleUserInput" text="Send" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
