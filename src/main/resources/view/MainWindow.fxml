<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="200.0" minWidth="320.0" prefHeight="600.0" prefWidth="440.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="max.ui.MainWindow">
  <children>
    <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="36.0" promptText="Enter a command" AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="82.0" />
    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="36.0" prefWidth="66.0" text="Run" AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="8.0" />
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0" AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <content>
        <VBox fx:id="dialogContainer" fillWidth="true" spacing="1.0" />
      </content>
    </ScrollPane>
  </children>
</AnchorPane>
