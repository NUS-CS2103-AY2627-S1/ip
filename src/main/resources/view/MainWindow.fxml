<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="520.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="walter.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="66.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="4.0">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <AnchorPane prefHeight="66.0" styleClass="input-area"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Jesse, what are we cooking today?"
                           AnchorPane.bottomAnchor="12.0"
                           AnchorPane.leftAnchor="12.0"
                           AnchorPane.rightAnchor="108.0"
                           AnchorPane.topAnchor="12.0" />
                <Button fx:id="sendButton" defaultButton="true"
                        onAction="#handleUserInput" prefWidth="86.0" text="Send"
                        AnchorPane.bottomAnchor="12.0"
                        AnchorPane.rightAnchor="12.0"
                        AnchorPane.topAnchor="12.0" />
            </children>
        </AnchorPane>
    </children>
</AnchorPane>
