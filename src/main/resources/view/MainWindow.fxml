<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="atlas.gui.MainWindow">
    <children>
        <!-- Fixed artwork, behind the scrolling chat and input controls. -->
        <Region styleClass="chat-background" mouseTransparent="true"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0"/>
        <!-- Chat canvas: spans the full window so messages can scroll under
             the header, which is painted on top of this pane. -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0"
                    prefHeight="514.0" prefWidth="400.0" vvalue="1.0"
                    AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" minWidth="0.0" spacing="10.0">
                    <padding>
                        <Insets bottom="18.0" left="12.0" right="12.0" top="92.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <Label styleClass="header-label" text="ATLAS"
               minHeight="80.0" prefHeight="80.0" maxHeight="80.0" prefWidth="400.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   prefHeight="36.0" prefWidth="300.0" promptText="Type a command for Atlas..."
                   AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="76.0"/>
        <Button fx:id="sendButton" mnemonicParsing="false"
                onAction="#handleUserInput" prefHeight="36.0" prefWidth="60.0" text="Send"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="12.0"/>
    </children>
    <stylesheets>
        <URL value="@../css/main.css"/>
    </stylesheets>
</AnchorPane>
