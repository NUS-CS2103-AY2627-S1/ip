<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="todd.MainWindow">
    <top>
        <VBox spacing="5.0" styleClass="header">
            <HBox spacing="16.0" alignment="TOP_LEFT">
                <VBox spacing="5.0" minWidth="0.0" HBox.hgrow="ALWAYS">
                    <Label text="Todd" styleClass="app-title" />
                    <Label text="Hopefully I can help you make it out alive. No promises."
                           styleClass="subtitle" wrapText="true" minWidth="0.0" minHeight="-Infinity" />
                </VBox>
                <ImageView fitWidth="80.0" fitHeight="84.0" preserveRatio="true"
                           accessibleText="Todd, your NPC task companion">
                    <image>
                        <Image url="@../images/todd.png" />
                    </image>
                </ImageView>
            </HBox>
            <HBox spacing="8.0" styleClass="shortcuts">
                <Button text="My tasks" onAction="#handleList" styleClass="shortcut" />
                <Button text="Reminders" onAction="#handleReminders" styleClass="shortcut" />
                <Button text="Help" onAction="#handleHelp" styleClass="shortcut" />
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane styleClass="campsite-background">
            <Region styleClass="background-wash" mouseTransparent="true" />
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll">
                <content>
                    <VBox fx:id="dialogContainer" spacing="18.0" styleClass="dialog-container" />
                </content>
            </ScrollPane>
        </StackPane>
    </center>
    <bottom>
        <VBox spacing="8.0" styleClass="composer">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput" promptText="Try: todo read notes" />
                <Button fx:id="sendButton" mnemonicParsing="false"
                        onAction="#handleUserInput" text="Send" styleClass="send-button" />
            </HBox>
            <Label text="Enter to send  ·  Type help for all commands" styleClass="input-hint" />
        </VBox>
    </bottom>
</BorderPane>
