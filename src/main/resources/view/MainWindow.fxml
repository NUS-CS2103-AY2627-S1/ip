<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kaykay.ui.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT"
              prefHeight="54.0"
              styleClass="mission-header"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Label styleClass="mission-title" text="Kaykay" />
                <Label styleClass="mission-subtitle" text="MISSION CONTROL" />
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    prefHeight="557.0"
                    prefWidth="400.0"
                    vbarPolicy="ALWAYS"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="72.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="54.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" styleClass="dialog-container">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER"
              spacing="8.0"
              styleClass="composer-container"
              AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="12.0"
              AnchorPane.rightAnchor="12.0">
            <children>
                <TextField fx:id="userInput"
                           maxWidth="Infinity"
                           onAction="#handleUserInput"
                           prefHeight="40.0"
                           promptText="Enter your next command..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="40.0"
                        prefWidth="76.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
