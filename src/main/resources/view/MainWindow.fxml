<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  The conversation fills the window and the input row is pinned to the bottom,
  so both keep their proportions when the window is resized. The input row is an
  HBox rather than two separately anchored controls so that the text field can
  grow and the Send button stays its natural width.
-->
<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="min.ui.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="48.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER"
              spacing="8.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="4.0" />
            </padding>
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           prefHeight="36.0"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="36.0"
                        prefWidth="76.0"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
