<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- A VBox rather than an AnchorPane: the input row keeps its natural height
     and the history takes everything else, at any window size, without the
     fixed bottom offset an AnchorPane needs. -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="milo.gui.MainWindow"
      prefHeight="600.0" prefWidth="420.0" minHeight="400.0" minWidth="340.0"
      stylesheets="@main.css">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" fitToWidth="true"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="6.0">
                    <padding>
                        <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox spacing="8.0" alignment="CENTER" styleClass="input-row">
            <padding>
                <Insets top="8.0" bottom="8.0" left="10.0" right="10.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" promptText="Type a command..." onAction="#handleUserInput"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" text="Send" minWidth="60.0" onAction="#handleUserInput" />
            </children>
        </HBox>
    </children>
</VBox>
