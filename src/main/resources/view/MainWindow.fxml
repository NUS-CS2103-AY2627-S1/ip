<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="540.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ollie.MainWindow">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="mission-header">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
            <VBox spacing="1.0">
                <Label styleClass="app-title" text="OLLIE" />
                <Label styleClass="app-subtitle" text="PERSONAL MISSION CONTROL" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="status-pill" text="●  ONLINE" />
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="6.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8.0" styleClass="input-bar">
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                       onAction="#handleUserInput"
                       promptText="Enter a mission command..." />
            <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                    prefWidth="88.0" text="Transmit" />
        </HBox>
    </bottom>
</BorderPane>
