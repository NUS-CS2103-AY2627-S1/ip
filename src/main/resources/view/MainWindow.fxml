<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="400.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.7"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="miaow.MainWindow">

    <children>

        <!-- Message area: declare this first -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="70.0"
                    AnchorPane.bottomAnchor="42.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="8.0"
                      prefWidth="388.0"/>
            </content>
        </ScrollPane>

        <!-- Header: declare after ScrollPane so it appears above it -->
        <HBox alignment="CENTER_LEFT"
              spacing="10.0"
              minHeight="70.0"
              prefHeight="70.0"
              maxHeight="70.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              styleClass="profile-header">

            <ImageView fitHeight="55.0"
                       fitWidth="55.0"
                       preserveRatio="true">
                <image>
                    <Image url="@../images/Miaowoiia.png"/>
                </image>
            </ImageView>

            <Label text="MiaowBot"
                   styleClass="profile-name"/>
        </HBox>

        <!-- Input field -->
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="42.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="76.0"/>

        <!-- Send button -->
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="42.0"
                prefWidth="76.0"
                text="Send"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    </children>
</AnchorPane>