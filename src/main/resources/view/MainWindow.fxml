<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="480.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nerrad.ui.MainWindow">
    <children>
        <Label layoutX="16.0" layoutY="12.0" styleClass="app-title" text="Nerrad" />
        <Label layoutX="16.0" layoutY="36.0" styleClass="app-subtitle" text="A quiet forest companion for your day" />
        <Label fx:id="summaryLabel" layoutX="16.0" layoutY="54.0" styleClass="summary-pill" />
        <Label layoutX="438.0" layoutY="13.0" styleClass="header-accent" text="✦" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    prefHeight="500.0" prefWidth="480.0"
                    AnchorPane.bottomAnchor="76.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="82.0">
            <content>
                <VBox fx:id="dialogContainer" prefWidth="460.0" spacing="4.0" />
            </content>
        </ScrollPane>
        <Label styleClass="command-hint" text="Choose a path: todo, list, loans, find, or bye  ✦"
               AnchorPane.bottomAnchor="54.0" AnchorPane.leftAnchor="8.0" />
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="What shall we tend to today?"
                   prefHeight="42.0" AnchorPane.bottomAnchor="4.0" AnchorPane.leftAnchor="6.0"
                   AnchorPane.rightAnchor="86.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="42.0"
                prefWidth="74.0" text="Send" AnchorPane.bottomAnchor="4.0" AnchorPane.rightAnchor="6.0" />
    </children>
</AnchorPane>
