<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="680.0" prefWidth="440.0"
            style="-fx-background-color: #070b18;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jonk.MainWindow">
    <children>
        <Label alignment="CENTER_LEFT"
               prefHeight="52.0"
               text="✦  JONK // MISSION CONTROL"
               style="-fx-background-color: #0f172a; -fx-text-fill: #67e8f9;
                      -fx-font-family: 'Avenir Next'; -fx-font-size: 17;
                      -fx-font-weight: bold; -fx-padding: 0 16 0 16;"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #070b18; -fx-background-color: #070b18;"
                    AnchorPane.bottomAnchor="58.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="52.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      prefWidth="428.0"
                      spacing="6.0"
                      style="-fx-background-color: #070b18; -fx-padding: 8 4 8 4;" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   promptText="Transmit a command…"
                   prefHeight="42.0"
                   style="-fx-background-color: #111827; -fx-background-radius: 10;
                          -fx-border-color: #334155; -fx-border-radius: 10;
                          -fx-text-fill: #f8fafc; -fx-prompt-text-fill: #94a3b8;
                          -fx-font-family: 'Avenir Next'; -fx-font-size: 13; -fx-padding: 0 12;"
                   AnchorPane.bottomAnchor="8.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="104.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="42.0"
                prefWidth="84.0"
                text="Transmit"
                style="-fx-background-color: #22d3ee; -fx-background-radius: 10;
                       -fx-text-fill: #07111f; -fx-font-family: 'Avenir Next';
                       -fx-font-size: 12; -fx-font-weight: bold;"
                AnchorPane.bottomAnchor="8.0"
                AnchorPane.rightAnchor="12.0" />
    </children>
</AnchorPane>
