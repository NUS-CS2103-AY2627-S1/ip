<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="420.0"
            minWidth="320.0"
            prefHeight="560.0"
            prefWidth="380.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="8.0" styleClass="input-bar">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="8.0"/>
            </padding>
            <children>
                <TextField fx:id="userInput"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Type a command, e.g. todo read book"/>
                <Button fx:id="sendButton"
                        defaultButton="true"
                        minWidth="64.0"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
