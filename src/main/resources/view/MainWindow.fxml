<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            minWidth="340" minHeight="220" prefWidth="400" prefHeight="600"
            fx:controller="lebron.MainWindow">
    <VBox styleClass="app-header" spacing="1"
          AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
        </padding>
        <Label text="Lebron" styleClass="header-title"/>
        <Label text="Your courtside task coach" styleClass="header-subtitle"/>
    </VBox>

    <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" fitToWidth="true"
                AnchorPane.topAnchor="67.0" AnchorPane.bottomAnchor="64.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <VBox fx:id="dialogContainer" spacing="12" styleClass="dialog-container">
            <padding>
                <Insets top="14" right="12" bottom="14" left="12"/>
            </padding>
        </VBox>
    </ScrollPane>

    <HBox styleClass="composer" spacing="8"
          AnchorPane.leftAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="10" right="12" bottom="10" left="12"/>
        </padding>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Call the next play..." HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"/>
    </HBox>
</AnchorPane>
