<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="520.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.7"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kiki.gui.MainWindow">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="dialogContainer" spacing="12.0" />
                </content>
            </ScrollPane>
            <Label styleClass="command-hint" text="Try: todo, deadline, event, list, or @ai ..." />
            <HBox spacing="10.0">
                <TextField fx:id="userInput" onAction="#handleUserInput"
                           promptText="Type a command..." HBox.hgrow="ALWAYS" />
                <Button minWidth="72.0" mnemonicParsing="false" onAction="#handleUserInput" text="Send" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
