<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="480.0" minWidth="360.0"
            prefHeight="720.0" prefWidth="520.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hampster.gui.MainWindow"
            stylesheets="@/view/main-window.css">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              styleClass="header"
              AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0"
              AnchorPane.topAnchor="18.0">
            <children>
                <StackPane styleClass="mascot" accessibleText="Evil hamster mascot">
                    <children>
                        <Circle radius="13.0" styleClass="hamster-face" />
                        <Circle radius="6.0" styleClass="hamster-ear"
                                translateX="-9.0" translateY="-10.0" />
                        <Circle radius="6.0" styleClass="hamster-ear"
                                translateX="9.0" translateY="-10.0" />
                        <Circle radius="2.0" styleClass="hamster-eye"
                                translateX="-5.0" translateY="-3.0" />
                        <Circle radius="2.0" styleClass="hamster-eye"
                                translateX="5.0" translateY="-3.0" />
                        <Circle radius="2.0" styleClass="hamster-nose"
                                translateY="2.0" />
                        <Line startX="-5.0" startY="5.0" endX="-1.0" endY="5.0"
                              styleClass="hamster-mouth" />
                        <Line startX="1.0" startY="5.0" endX="5.0" endY="5.0"
                              styleClass="hamster-mouth" />
                    </children>
                </StackPane>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="app-title" text="HAMPSTER" />
                        <Label styleClass="app-subtitle"
                               text="Your tiny evil task overlord" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="conversation-scroll"
                    AnchorPane.bottomAnchor="84.0"
                    AnchorPane.leftAnchor="12.0"
                    AnchorPane.rightAnchor="12.0"
                    AnchorPane.topAnchor="72.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" spacing="8.0"
              styleClass="composer"
              AnchorPane.bottomAnchor="16.0"
              AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0">
            <children>
                <TextField fx:id="userInput"
                           promptText="Issue a command, minion..."
                           onAction="#handleUserInput"
                           HBox.hgrow="ALWAYS" />
                <Button defaultButton="true"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Execute" />
            </children>
        </HBox>
    </children>
</AnchorPane>
