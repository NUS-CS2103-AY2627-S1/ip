<?xml version="1.0" encoding="UTF-8"?>

<!--
  The chatbot's window: the conversation above, the box the user types into and
  the Send button below it.

  Both the text field and the button call handleUserInput, so pressing Enter and
  clicking Send are one action rather than two that have to be kept in step.

  The anchors are what make the window usable at any size: the scrolling
  conversation is pinned to all four edges, the input row to the bottom two
  corners, and the button to the bottom right, so dragging the window wider makes
  the conversation and the input box wider rather than leaving a gap.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="620.0"
            prefWidth="420.0"
            stylesheets="@/css/main.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bob.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="52.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="40.0"
                   promptText="Tell Bob what to do, like: list"
                   AnchorPane.bottomAnchor="6.0"
                   AnchorPane.leftAnchor="6.0"
                   AnchorPane.rightAnchor="86.0" />
        <Button fx:id="sendButton"
                defaultButton="true"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="40.0"
                prefWidth="74.0"
                text="Baboi!"
                AnchorPane.bottomAnchor="6.0"
                AnchorPane.rightAnchor="6.0" />
    </children>
</AnchorPane>
