<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- A VBox rather than absolute positions: the conversation grows with the window and the input bar keeps its height. -->
<VBox prefHeight="600.0" prefWidth="420.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="thomas.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0" styleClass="conversation">
                    <padding>
                        <Insets bottom="8.0" top="8.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox fx:id="inputBar" spacing="8.0" styleClass="input-bar">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Tell Thomas what to haul, e.g. todo read book" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" defaultButton="true" mnemonicParsing="false" onAction="#handleUserInput" text="Peep!" />
            </children>
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
        </HBox>
    </children>
</VBox>
