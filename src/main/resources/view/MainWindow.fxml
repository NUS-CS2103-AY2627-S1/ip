<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="440.0"
      minWidth="340.0"
      prefHeight="600.0"
      prefWidth="420.0"
      stylesheets="@Styles.css"
      styleClass="root-pane"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="luna.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="conversation-scroll"
                    VBox.vgrow="ALWAYS"
                    vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="4.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER"
              spacing="8.0"
              styleClass="composer">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           promptText="Type a command…"
                           styleClass="command-field"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        defaultButton="true"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        styleClass="send-button"
                        text="Send" />
            </children>
            <padding>
                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
            </padding>
        </HBox>
    </children>
</VBox>
