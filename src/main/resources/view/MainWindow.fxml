<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="480.0" styleClass="main-window" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="bogos.MainWindow">
    <stylesheets>
        <URL value="@../styles/bogos.css" />
    </stylesheets>
    <children>
        <VBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="3.0" styleClass="app-header"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="BOGOS" styleClass="app-title" />
                <Label text="Bogos' Big-Business Bulletin" styleClass="app-subtitle" />
            </children>
        </VBox>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0"
                   promptText="Bring Bogos business..." styleClass="command-input"
                   AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="108.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="48.0"
                prefWidth="76.0" text="Beam it" styleClass="send-button"
                AnchorPane.bottomAnchor="14.0" AnchorPane.rightAnchor="16.0" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0"
                    styleClass="chat-scroll-pane" AnchorPane.bottomAnchor="74.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="90.0">
            <content>
                <VBox fx:id="dialogContainer" styleClass="dialog-container" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
