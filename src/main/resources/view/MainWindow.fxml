<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="zaru.ui.MainWindow"
            stylesheets="@../css/main.css">
    <children>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="66.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      prefWidth="388.0"
                      spacing="2.0">
                    <padding>
                        <Insets bottom="12.0" left="6.0" right="6.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="44.0"
                   promptText="Type a message..."
                   AnchorPane.bottomAnchor="11.0"
                   AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="105.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="44.0"
                prefWidth="82.0"
                text="Send"
                AnchorPane.bottomAnchor="11.0"
                AnchorPane.rightAnchor="12.0" />
    </children>
</AnchorPane>

