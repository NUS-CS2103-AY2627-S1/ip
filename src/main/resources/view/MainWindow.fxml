<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="220.0" minWidth="360.0"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="waddles.MainWindow" styleClass="root-pane">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="0.0" vvalue="1.0"
                    fitToWidth="true" prefHeight="600.0" prefWidth="400.0"
                    styleClass="conversation"
                    AnchorPane.bottomAnchor="52.0" AnchorPane.leftAnchor="1.0"
                    AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="543.0" prefWidth="393.0"
                      styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Type a command..." styleClass="command-input"
                   prefHeight="41.0" prefWidth="324.0"
                   AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0"
                   AnchorPane.rightAnchor="61.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                text="Send" styleClass="send-button" prefHeight="41.0" prefWidth="55.0"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0" />
    </children>
</AnchorPane>
