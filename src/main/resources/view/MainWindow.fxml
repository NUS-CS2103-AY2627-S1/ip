<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="620.0"
            stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nob.ui.MainWindow">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <VBox fx:id="dialogContainer" spacing="16.0" styleClass="dialog-container" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8.0" styleClass="input-bar">
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                       onAction="#handleUserInput"
                       promptText="Enter a command, e.g. todo read book" />
            <Button defaultButton="true" onAction="#handleUserInput"
                    styleClass="send-button" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
