<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="kdb.MainWindow"
            prefWidth="600.0"
            prefHeight="400.0">
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" fillWidth="true"/>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8.0" styleClass="input-bar">
            <TextField fx:id="userInput" promptText="Type a command..."
                       onAction="#handleUserInput" HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"/>
        </HBox>
    </bottom>
</BorderPane>
