<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="450.0" prefWidth="650.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="prism.ui.MainWindow" style="-fx-background-color: #f7f9fc;">
    <children>
        <TextField fx:id="commandField"
                   onAction="#handleUserInput"
                   prefHeight="41.0"
                   promptText="Enter a command, e.g. list or todo read book"
                   style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 10 12;"
                   AnchorPane.bottomAnchor="1.0"
                   AnchorPane.leftAnchor="1.0"
                   AnchorPane.rightAnchor="77.0" />
        <Button fx:id="sendButton"
                defaultButton="true"
                onAction="#handleUserInput"
                prefHeight="41.0"
                prefWidth="76.0"
                text="Send"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8;"
                AnchorPane.bottomAnchor="1.0"
                AnchorPane.rightAnchor="1.0" />
        <ScrollPane fx:id="conversationPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="43.0"
                    AnchorPane.leftAnchor="1.0"
                    AnchorPane.rightAnchor="1.0"
                    AnchorPane.topAnchor="1.0"
                    style="-fx-background: #f7f9fc; -fx-background-color: #f7f9fc;">
            <content>
                <VBox fx:id="conversation" spacing="8" maxWidth="1.7976931348623157E308"
                      maxHeight="1.7976931348623157E308" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
