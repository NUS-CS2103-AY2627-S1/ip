<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="470" minWidth="417"
            xmlns="http://javafx.com/javafx/17" fx:controller="ducky.MainWindow"
            xmlns:fx="http://javafx.com/fxml/1" styleClass="root-pane">
    <children>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" vbarPolicy="ALWAYS" fitToWidth="true"
                    styleClass="scroll-pane"
                    AnchorPane.bottomAnchor="55.0" AnchorPane.leftAnchor="1.0"
                    AnchorPane.rightAnchor="1.0" AnchorPane.topAnchor="1.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10" styleClass="dialog-container">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="8.0" styleClass="input-row"
              AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" styleClass="user-input"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity" promptText="Type a command..."/>
                <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" styleClass="send-button"/>
            </children>
        </HBox>
    </children>
</AnchorPane>
