<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="chin.MainWindow" prefHeight="620.0" prefWidth="420.0">
    <ScrollPane fx:id="scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="messages" spacing="8">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </VBox>
        </content>
    </ScrollPane>
    <HBox spacing="8" alignment="CENTER">
        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
        <TextField fx:id="input" promptText="Type a message..." HBox.hgrow="ALWAYS"
                   onAction="#handleUserInput"/>
        <Button fx:id="send" text="Send" onAction="#handleUserInput"
                style="-fx-background-color: #4a90e2; -fx-text-fill: white; -fx-background-radius: 6;"/>
    </HBox>
</VBox>
