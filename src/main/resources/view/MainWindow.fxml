<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="900.0" prefWidth="600.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="doe.MainWindow">
    <children>
        <VBox fx:id="terminal" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="terminal-header">
                    <children>
                        <Label text="DOE // TASK TERMINAL" styleClass="terminal-title" />
                    </children>
                    <padding><Insets bottom="14.0" left="24.0" right="24.0" top="14.0" /></padding>
                </HBox>
                <StackPane fx:id="bannerPanel" alignment="CENTER" minWidth="0.0"
                           minHeight="140.0" prefHeight="140.0" maxHeight="140.0"
                           styleClass="ascii-panel">
                    <children>
                        <ImageView fx:id="bannerImage" fitHeight="140.0" pickOnBounds="true"
                                   preserveRatio="true" smooth="false" />
                    </children>
                    <VBox.margin><Insets bottom="16.0" left="22.0" right="22.0" top="18.0" /></VBox.margin>
                </StackPane>
                <ScrollPane fx:id="scrollPane" minWidth="0.0" minHeight="0.0"
                            fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll">
                    <content>
                        <VBox fx:id="dialogContainer" minWidth="0.0" fillWidth="true" spacing="6.0" />
                    </content>
                    <VBox.vgrow><Priority fx:constant="ALWAYS" /></VBox.vgrow>
                    <VBox.margin><Insets left="22.0" right="22.0" /></VBox.margin>
                </ScrollPane>
                <HBox fx:id="commandBar" alignment="CENTER" spacing="14.0" styleClass="command-bar">
                    <children>
                        <Label text=">" styleClass="prompt-symbol" />
                        <TextField fx:id="userInput" minWidth="0.0" onAction="#handleUserInput" promptText="enter command..."
                                   styleClass="command-input">
                            <HBox.hgrow><Priority fx:constant="ALWAYS" /></HBox.hgrow>
                        </TextField>
                        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                                prefWidth="112.0" text="SEND" styleClass="send-button" />
                    </children>
                    <VBox.margin><Insets bottom="20.0" left="22.0" right="22.0" top="16.0" /></VBox.margin>
                    <padding><Insets bottom="12.0" left="14.0" right="14.0" top="12.0" /></padding>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
