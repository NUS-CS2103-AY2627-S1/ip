<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="480.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ari.gui.MainWindow">
    <children>
        <VBox id="header"
              prefHeight="76.0"
              spacing="3.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
            </padding>
            <children>
                <Label id="appTitle" text="Ari" />
                <Label id="appSubtitle" text="Your tasks, one command at a time" />
            </children>
        </VBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="66.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="76.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="4.0">
                    <padding>
                        <Insets bottom="16.0" left="10.0" right="10.0" top="16.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox id="inputBar"
              spacing="10.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
            </padding>
            <children>
                <TextField fx:id="userInput"
                           accessibleText="Task command"
                           HBox.hgrow="ALWAYS"
                           onAction="#handleUserInput"
                           promptText="Try: todo read chapter 4" />
                <Button fx:id="sendButton"
                        defaultButton="true"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
