<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!--
  The main chat window. The AnchorPane pins the scrolling message area to the
  top and the input row (text field + Send button) to the bottom.
  fx:controller ties every fx:id and onAction below to pan.MainWindow.

  stylesheets="@styles.css" loads the sibling stylesheet in this folder; the
  styleClass names below are what it hooks onto. Colours and padding live
  there rather than here, so the layout and the look stay separable.
-->
<AnchorPane fx:id="mainLayout" prefHeight="600.0" prefWidth="400.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pan.MainWindow">
    <children>
        <!--
          vbarPolicy is AS_NEEDED rather than ALWAYS: an always-on scrollbar
          costs ~10px of width even in an empty window, which the brief asks
          us not to waste.
        -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="52.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0">
                    <padding>
                        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Say something to PanPan~"
                   styleClass="input-field" prefHeight="34.0"
                   AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="78.0" AnchorPane.bottomAnchor="12.0" />
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"
                styleClass="send-button" prefWidth="58.0" prefHeight="34.0"
                AnchorPane.rightAnchor="12.0" AnchorPane.bottomAnchor="12.0" />
    </children>
</AnchorPane>
