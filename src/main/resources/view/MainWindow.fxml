<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainWindow"
            minHeight="520.0" minWidth="420.0"
            prefHeight="620.0" prefWidth="460.0"
            stylesheets="@../css/main.css"
            styleClass="app-shell"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nexus.MainWindow">
    <top>
        <VBox spacing="2.0" styleClass="focus-rail">
            <children>
                <Label text="Nexus" styleClass="app-title" />
                <Label text="A calm place to get things done" styleClass="app-subtitle" />
            </children>
            <padding>
                <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="conversation-scroll"
                    vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      spacing="4.0"
                      styleClass="conversation" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="7.0" styleClass="composer">
            <children>
                <Label text="Try: todo read chapter 4  •  list  •  mark 1"
                       styleClass="command-hint" />
                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <TextField fx:id="userInput"
                                   onAction="#handleUserInput"
                                   promptText="What needs doing?"
                                   styleClass="command-input"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton"
                                defaultButton="true"
                                mnemonicParsing="false"
                                onAction="#handleUserInput"
                                text="Send"
                                styleClass="send-button" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="10.0" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>
