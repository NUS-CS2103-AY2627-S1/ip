<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!--
  prefHeight/prefWidth set the size the window opens at. There is deliberately
  no maxHeight/maxWidth: setting those to -Infinity means USE_PREF_SIZE, which
  would cap this pane at 400x600 no matter how large the window grew.

  Every child is anchored rather than placed with layoutX/layoutY, so the
  conversation fills whatever room it is given and the input row stays along
  the bottom edge.
-->
<AnchorPane minHeight="220.0" minWidth="417.0"
            prefHeight="600.0" prefWidth="400.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kenbot.MainWindow">
    <children>
        <!-- Anchored on all four sides, stopping 41px short of the bottom to
             leave exactly the height of the input row. fitToWidth makes the
             dialog boxes inside span the full width instead of staying at
             their own preferred size. -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="41.0">
            <content>
                <VBox fx:id="dialogContainer" />
            </content>
        </ScrollPane>

        <!-- Left edge to 76px from the right, which is where the button starts. -->
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="41.0"
                   promptText="Type a command, then press Enter"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="76.0"
                   AnchorPane.bottomAnchor="0.0" />

        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="41.0"
                prefWidth="76.0"
                text="Send"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.bottomAnchor="0.0" />
    </children>
</AnchorPane>
