<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="friday.MainWindow">
    <children>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0"
                   promptText="Ask FRIDAY"
                   AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0"
                   AnchorPane.rightAnchor="64.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="48.0" prefWidth="48.0" text="➤"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="8.0">
            <tooltip>
                <Tooltip text="Send message" />
            </tooltip>
        </Button>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" hvalue="1.0"
                    vvalue="1.0" AnchorPane.bottomAnchor="64.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" prefWidth="388.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
