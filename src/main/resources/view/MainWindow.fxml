<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="560.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="aether.gui.MainWindow">
    <top>
        <VBox spacing="3.0" styleClass="header">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
            </padding>
            <Label styleClass="title" text="Aether" />
            <Label styleClass="subtitle" text="A calm guide for busy days" />
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    pannable="true" styleClass="chat-scroll-pane">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="12.0" styleClass="dialog-container">
                    <padding>
                        <Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10.0" styleClass="composer">
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
            <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command..."
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" />
        </HBox>
    </bottom>
</BorderPane>
