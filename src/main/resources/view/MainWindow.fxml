<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="520.0" spacing="8.0"
      stylesheets="@Hermes.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="duke.MainWindow">
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="dialogContainer" spacing="8.0" styleClass="dialog-container" />
        </content>
    </ScrollPane>
    <HBox spacing="8.0" styleClass="input-row">
        <TextField fx:id="userInput" onAction="#handleUserInput"
                   promptText="Enter a command" HBox.hgrow="ALWAYS" />
        <Button fx:id="sendButton" onAction="#handleUserInput" text="Send" />
    </HBox>
</VBox>
