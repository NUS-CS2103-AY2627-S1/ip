<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="760.0" prefWidth="560.0" stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17.0.7" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ramly.gui.MainWindow">
    <children>
        <VBox fx:id="header" spacing="4.0" styleClass="header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="18.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="eyebrow" text="PIP / POCKET PATHFINDER" />
                <Label styleClass="title" text="One step at a time." />
                <Label styleClass="subtitle" text="A calm trail through everything you need to do." />
            </children>
        </VBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                    AnchorPane.bottomAnchor="82.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="115.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" fillWidth="true">
                    <padding>
                        <Insets bottom="22.0" left="20.0" right="20.0" top="22.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox spacing="10.0" styleClass="composer" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets bottom="18.0" left="20.0" right="20.0" top="14.0" />
            </padding>
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Type a command..."
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send" />
            </children>
        </HBox>
    </children>
</AnchorPane>
