<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="xuan.ui.MainWindow">

    <children>

        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="55.0">

            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true" />
            </content>

        </ScrollPane>

        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   promptText="Enter your message..."
                   prefHeight="36.0"
                   style="-fx-background-radius: 10;
                  -fx-border-radius: 10;
                  -fx-border-color: #cccccc;
                  -fx-padding: 0 12 0 12;"
                   AnchorPane.leftAnchor="8.0"
                   AnchorPane.rightAnchor="88.0"
                   AnchorPane.bottomAnchor="8.0" />

        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="36.0"
                prefWidth="72.0"
                text="Send"
                style="-fx-background-color: #4A90E2;
               -fx-text-fill: white;
               -fx-font-weight: bold;
               -fx-background-radius: 10;"
                AnchorPane.rightAnchor="8.0"
                AnchorPane.bottomAnchor="8.0" />

    </children>
</AnchorPane>