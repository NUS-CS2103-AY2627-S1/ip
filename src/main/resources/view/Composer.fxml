<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="CENTER" spacing="10.0" styleClass="composer"
         maxWidth="880.0" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <TextArea fx:id="userInput" wrapText="true" prefRowCount="2" prefHeight="72.0"
                   minWidth="0.0" accessibleText="Command"
                   promptText="Try “todo read book” or “help”"
                   HBox.hgrow="ALWAYS" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleSubmit"
                text="Send"
                styleClass="primary-button" />
    </children>
</fx:root>
