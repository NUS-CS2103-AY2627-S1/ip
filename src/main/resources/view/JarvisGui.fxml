<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="655.0" prefWidth="850.0" styleClass="chat-root" stylesheets="@../style/JarvisGui.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jarvis.ui.JarvisGuiController">

    <children>

        <!-- ========================= -->
        <!-- J.A.R.V.I.S. Header       -->
        <!-- ========================= -->

        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="jarvis-header" AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="8.0">

            <children>

                <Label text="J.A.R.V.I.S." styleClass="jarvis-title" />

                <Label text="● ONLINE" styleClass="system-status" />

                <Label fx:id="taskStatusLabel" text="TASKS: 0" styleClass="system-info" />


            </children>

        </HBox>

        <!-- ========================= -->
        <!-- Chat display area          -->
        <!-- ========================= -->

        <ScrollPane fx:id="scrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll-pane"
                    AnchorPane.bottomAnchor="62.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="50.0">

            <content>

                <VBox fx:id="dialogContainer" fillWidth="true" spacing="2.0" styleClass="dialog-container">

                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>

                </VBox>

            </content>

        </ScrollPane>


        <!-- ========================= -->
        <!-- Input area                -->
        <!-- ========================= -->

        <HBox alignment="CENTER" prefHeight="42.0" spacing="10.0" styleClass="input-container" AnchorPane.bottomAnchor="10.0"
              AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">

            <children>

                <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="42.0"
                           promptText="Awaiting your instructions..." styleClass="user-input" HBox.hgrow="ALWAYS" />

                <Button fx:id="sendButton" onAction="#handleUserInput" prefHeight="42.0"
                        prefWidth="115.0" styleClass="send-button" text="EXECUTE" />

            </children>

        </HBox>

    </children>

</AnchorPane>
