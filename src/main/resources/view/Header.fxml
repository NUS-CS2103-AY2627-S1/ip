<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>

<fx:root alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <StackPane minWidth="48.0" prefWidth="48.0" maxWidth="48.0" accessibleText="Duchess precinct badge">
            <SVGPath styleClass="brand-shield"
                     content="M22 1 L42 8 L42 23 C42 34 34 41 22 47 C10 41 2 34 2 23 L2 8 Z" />
            <Label text="99" styleClass="brand-badge-number" />
        </StackPane>
        <VBox spacing="2.0" minWidth="0.0" HBox.hgrow="ALWAYS">
            <Label text="Duchess" styleClass="brand-title" />
            <Label wrapText="true" text="Your precinct task partner" styleClass="brand-subtitle" />
            <Label wrapText="true" fx:id="statusLabel" text="★ Squad ready. Nine-Nine!" styleClass="status-pill, status-ready" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="helpButton"
                mnemonicParsing="false"
                onAction="#handleHelp"
                text="? Help"
                styleClass="secondary-button" />
    </children>
</fx:root>
