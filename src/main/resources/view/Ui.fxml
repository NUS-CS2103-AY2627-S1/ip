<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17.0.7"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../css/ui.css"
            styleClass="chat-window">
    <children>
        <VBox spacing="3.0" styleClass="chat-header"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="NICO" styleClass="chat-title" />
                <Label text="Your friendly task companion" styleClass="chat-subtitle" />
            </children>
        </VBox>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="conversation-scroll"
                    AnchorPane.bottomAnchor="76.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="82.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" styleClass="dialog-container" />
            </content>
        </ScrollPane>
        <HBox spacing="10.0" styleClass="composer"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" HBox.hgrow="ALWAYS"
                           promptText="Type a command or a message..." styleClass="message-input" />
                <Button fx:id="sendButton" mnemonicParsing="false" text="Send" styleClass="send-button" />
            </children>
        </HBox>
    </children>
</AnchorPane>
