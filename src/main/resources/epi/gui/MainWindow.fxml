<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="epi.gui.MainWindow" stylesheets="@main.css">
    <top>
        <Label text="Epi's Purr-fect Task Companion" styleClass="header"
               maxWidth="Infinity" minWidth="0" wrapText="true" />
    </top>
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    minWidth="0" minHeight="0" focusTraversable="false">
            <content>
                <VBox fx:id="dialogContainer" spacing="14" minWidth="0" styleClass="conversation" />
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="input-bar">
            <TextField fx:id="userInput" HBox.hgrow="ALWAYS" minWidth="0" onAction="#handleUserInput"
                       accessibleText="Command input"
                       promptText="Type a command, human..." />
            <Button text="Send" minWidth="72" onAction="#handleUserInput" />
        </HBox>
    </bottom>
</BorderPane>
