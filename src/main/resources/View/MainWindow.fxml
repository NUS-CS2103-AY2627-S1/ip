<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="600.0" prefWidth="400.0"
            stylesheets="@../main.css" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="anaconda.gui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vvalue="1.0"
                    AnchorPane.bottomAnchor="64.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" />
            </content>
        </ScrollPane>
        <HBox fx:id="inputBar" styleClass="input-bar" alignment="CENTER_LEFT" spacing="8.0"
              minHeight="64.0" prefHeight="64.0" maxHeight="64.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <TextField fx:id="userInput" onAction="#handleUserInput" promptText="Enter a command&#8230;"
                           accessibleText="Command" minWidth="0.0" prefHeight="42.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" text="Send"
                        minWidth="76.0" prefWidth="76.0" prefHeight="42.0" />
            </children>
        </HBox>
    </children>
</AnchorPane>
