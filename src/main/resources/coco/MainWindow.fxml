<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="420.0" minWidth="320.0"
            prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="coco.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    styleClass="chat-scroll-pane"
                    AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="54.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="10.0" styleClass="dialog-container">
                    <padding>
                        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" promptText="Type a command..." onAction="#handleUserInput"
                   styleClass="user-input"
                   AnchorPane.bottomAnchor="8.0" AnchorPane.leftAnchor="8.0" AnchorPane.rightAnchor="80.0" />
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"
                styleClass="send-button"
                AnchorPane.bottomAnchor="8.0" AnchorPane.rightAnchor="8.0" />
    </children>
</AnchorPane>
