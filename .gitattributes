# Let Git detect text files and normalize them to LF in the repository.
* text=auto eol=lf

# Keep source, configuration, documentation, and test data consistent.
*.java text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Preserve the native line ending convention for the Windows launcher.
*.bat text eol=crlf
