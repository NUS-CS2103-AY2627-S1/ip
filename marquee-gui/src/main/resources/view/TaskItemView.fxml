<?xml version="1.0" encoding="UTF-8"?>


<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<fx:root maxHeight="-Infinity" minHeight="-Infinity" prefHeight="75.0" styleClass="task-item" stylesheets="@../style/task-list.css" type="HBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <StackPane maxWidth="-Infinity" minWidth="-Infinity" prefWidth="50.0">
         <children>
            <Label fx:id="id" contentDisplay="TEXT_ONLY" graphicTextGap="0.0" text="ID" wrapText="true" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <styleClass>
            <String fx:value="field" />
            <String fx:value="first-field" />
         </styleClass>
      </StackPane>
      <GridPane alignment="BOTTOM_RIGHT" stylesheets="@../style/task-list.css" HBox.hgrow="ALWAYS">
         <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="150.0" percentWidth="45.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints maxHeight="1.7976931348623157E308" valignment="TOP" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <StackPane styleClass="field">
               <children>
                  <Label fx:id="description" contentDisplay="TEXT_ONLY" graphicTextGap="0.0" text="New Task" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </StackPane>
            <AnchorPane fx:id="tagsContainer" maxHeight="75.0" minHeight="75.0" prefHeight="75.0" styleClass="field" GridPane.columnIndex="1">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </AnchorPane>
         </children>
      </GridPane>
      <VBox alignment="CENTER" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="150.0" styleClass="field">
         <children>
            <Label fx:id="start" text="Start Time" />
            <Label text="—" />
            <Label fx:id="end" text="End Time" />
         </children>
      </VBox>
   </children>
</fx:root>
