<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<fx:root alignment="CENTER_LEFT" spacing="10.0" stylesheets="@../style/tag-list.css" type="HBox" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="hiddenCountLabel" contentDisplay="TEXT_ONLY" opacity="0.5" text="Label" />
      <HBox fx:id="buttonContainer" alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="5.0">
         <children>
            <Button contentDisplay="GRAPHIC_ONLY" graphicTextGap="0.0" minHeight="0.0" minWidth="0.0" mnemonicParsing="false" onAction="#addTag">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true" rotate="45.0">
                     <image>
                        <Image url="@../icon/close.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
         <styleClass>
            <String fx:value="add-button" />
            <String fx:value="tag-chip" />
         </styleClass>
      </HBox>
   </children>
</fx:root>
