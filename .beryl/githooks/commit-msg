#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
  exit 0
fi

cd "${REPO_ROOT}"
if command -v gitlint >/dev/null 2>&1; then
  gitlint --config .gitlint --msg-filename "$1"
elif command -v cmd.exe >/dev/null 2>&1; then
  cmd.exe /d /c "gitlint --config .gitlint --msg-filename \"$1\""
else
  exit 0
fi
